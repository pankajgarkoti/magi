[Unit]
# not for system accounts or GDM's greeter account (these units are enabled for every user)
ConditionUser=!@system
ConditionUser=!gdm-greeter
ConditionUser=!gdm
Description=Save the tmux layout every minute

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target

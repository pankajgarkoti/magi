[Unit]
# not for system accounts or GDM's greeter account (these units are enabled for every user)
ConditionUser=!@system
ConditionUser=!gdm-greeter
ConditionUser=!gdm
Description=MAGI orchestrator health check every 15 minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=15min

[Install]
WantedBy=timers.target

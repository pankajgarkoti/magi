[Unit]
# not for system accounts or GDM's greeter account (these units are enabled for every user)
ConditionUser=!@system
ConditionUser=!gdm-greeter
ConditionUser=!gdm
Description=Open-threads reminder every 3 hours (00:30, 03:30, ... local time)

[Timer]
OnCalendar=*-*-* 00/3:30:00
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target

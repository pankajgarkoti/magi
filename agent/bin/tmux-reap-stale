#!/usr/bin/env python3
"""Close agent sessions in tmux that have sat idle, so they stop holding memory.

Works for every agent MAGI has an adapter for (Claude Code, opencode, Codex, a custom
command; see agent/lib/magi_agents.py). A session is closed only when ALL of these hold:
  - its agent process is alive and its state is "idle" (from the agent's own status files or
    API where it has them, otherwise from its tmux pane)
  - it has been idle for IDLE_MIN minutes (LOW_MEM_IDLE_MIN when memory is short)
  - its window isn't exempt (the orchestrator, notes, HUD windows)
  - its pane shows no question, menu or permission prompt waiting on the user
  - its input box holds no typed draft (for agents whose prompt MAGI can read)
Every close is logged with the resume command (or "starts fresh" for agents that can't
resume), so nothing is lost: ~/.local/state/tmux-reap/closed.log

Usage: tmux-reap-stale [--dry-run]
Settings (environment): REAP_IDLE_MIN (60), REAP_LOW_MEM_IDLE_MIN (20),
REAP_LOW_MEM_MB (2500), REAP_EXEMPT (orchestrator,notes,listen,hud-listen).
If an agent update changes what MAGI reads, that agent reads as not idle and nothing closes.
"""
import os, pathlib, re, shlex, subprocess, sys, time

sys.path.insert(0, str(pathlib.Path(os.path.realpath(__file__)).parent.parent / "lib"))
import magi_agents  # noqa: E402

IDLE_MIN = int(os.environ.get("REAP_IDLE_MIN", "60"))
LOW_MEM_IDLE_MIN = int(os.environ.get("REAP_LOW_MEM_IDLE_MIN", "20"))
LOW_MEM_MB = int(os.environ.get("REAP_LOW_MEM_MB", "2500"))
# Window names never closed. Comma-separated in REAP_EXEMPT.
EXEMPT = set(filter(None, os.environ.get("REAP_EXEMPT", "orchestrator,notes,listen,hud-listen").split(",")))
DRY = "--dry-run" in sys.argv

STATE = pathlib.Path.home() / ".local/state/tmux-reap"
STATE.mkdir(parents=True, exist_ok=True)
LOG = STATE / "closed.log"


def sh(*a):
    return subprocess.run(a, capture_output=True, text=True).stdout


def available_mb():
    for line in open("/proc/meminfo"):
        if line.startswith("MemAvailable:"):
            return int(line.split()[1]) // 1024
    return 10**6


def main():
    limit = LOW_MEM_IDLE_MIN if available_mb() < LOW_MEM_MB else IDLE_MIN
    for r in magi_agents.agents():
        a = magi_agents.get(r["agent"])
        if r["state"] != "idle" or r["idle_min"] < limit:
            continue
        if not os.path.exists(f"/proc/{r['pid']}"):
            continue
        pane, win = r["pane"], r["window"]
        if not win or win in EXEMPT:
            continue
        if re.search(a.ask_re, magi_agents.screen_tail(pane), re.I) or a.draft(pane):
            continue
        cmd = a.resume_cmd(r["session_id"], r["flags"], r["cwd"])
        how = ("resume: cd %s && %s" % (shlex.quote(r["cwd"] or "~"), " ".join(shlex.quote(c) for c in cmd))
               if cmd else "can't resume (%s starts fresh)" % a.label)
        line = f"{time.strftime('%Y-%m-%d %H:%M')}  {win}  {a.name}  idle {r['idle_min']}m  {how}"
        if DRY:
            print("would close", line)
            continue
        panes = sh("tmux", "list-panes", "-t", pane, "-F", "#{pane_id}").split()
        if len(panes) <= 1:
            sh("tmux", "kill-window", "-t", pane)
        else:
            sh("tmux", "kill-pane", "-t", pane)
        with open(LOG, "a") as fh:
            fh.write(line + "\n")
        print("closed", line)


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""magi-pilot-setup: first-login setup for the MAGI orchestrator.

Four steps, each skippable: what the orchestrator is -> pick and install the agent (Claude
Code, opencode, Codex, or any terminal agent; each from its official installer, nothing
bundled) -> sign in to the user's own account -> local voice (mic, level meter, transcript
test, speaking test). Styled from the active MAGI theme
(~/.config/hypr/themes/current/colors.css), like the control centre.

  magi-pilot-setup            open (magi-agent firstrun opens it once, on the first login)
  MAGI_SETUP_STEP=3 ...       start on a step (testing / screenshots)
"""
import json
import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

HOME = os.path.expanduser("~")
COLORS = HOME + "/.config/hypr/themes/current/colors.css"
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", HOME + "/.local/state"), "magi/agent")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", HOME + "/.config"), "magi/agent.conf")
AGENTS_PY = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "magi_agents.py")
CHOICES = [("claude", "CLAUDE CODE", "Anthropic"), ("opencode", "OPENCODE", "open source, many providers"),
           ("codex", "CODEX", "OpenAI"), ("custom", "CUSTOM COMMAND", "any terminal agent")]

CSS = """
@import url("file://%s");
* { font-family: "IosevkaTerm Nerd Font Mono"; border-radius: 0; box-shadow: none; outline: none; }
window.pilot { background: alpha(@base, 0.96); color: @text; border: 1px solid @accent; }
.header { background: @accent; color: @base; padding: 5px 12px; }
.header .title { font-size: 12px; font-weight: 800; letter-spacing: 3px; }

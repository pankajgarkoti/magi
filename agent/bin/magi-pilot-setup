.status.err { color: @bad; } .status.ok { color: @good; } .status.warn { color: @warn; }
""" % COLORS

STEPS = ["ORCHESTRATOR", "AGENT", "SIGN IN", "VOICE"]


def lbl(text, *cls, wrap=False, xalign=0.0, hexpand=False):
    w = Gtk.Label(label=text, xalign=xalign, hexpand=hexpand)
    for c in cls:
        w.add_css_class(c)
    if wrap:
        w.set_wrap(True)
        w.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
        w.set_max_width_chars(80)
    return w


def btn(text, cb, primary=False):
    b = Gtk.Button(label=text)
    if primary:
        b.add_css_class("primary")
    b.connect("clicked", lambda *_: cb())
    return b


def which(cmd):
    path = os.environ.get("PATH", "") + ":" + HOME + "/.local/bin"
    for d in path.split(":"):
        if d and os.access(os.path.join(d, cmd), os.X_OK):
            return os.path.join(d, cmd)
    return None


def set_conf(key, value):
    import shlex
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    lines = open(CONF).read().splitlines() if os.path.exists(CONF) else []
    lines = [l for l in lines if not l.startswith(key + "=")] + [f"{key}={shlex.quote(str(value))}"]
    open(CONF, "w").write("\n".join(lines) + "\n")


def touch(name):
    os.makedirs(STATE, exist_ok=True)
    open(os.path.join(STATE, name), "a").close()


def agent_info(name=None):
    try:
        out = subprocess.run([sys.executable, AGENTS_PY, "info", *([name] if name else [])],
                             capture_output=True, text=True, timeout=15).stdout
        return json.loads(out)
    except Exception:
        return {"name": name or "claude", "label": name or "agent", "installed": False}


def sources():
    try:
        out = subprocess.run(["pactl", "-f", "json", "list", "sources"], capture_output=True, text=True, timeout=5).stdout
        return [(s["name"], s.get("description") or s["name"]) for s in json.loads(out)]
    except Exception:
        return []


class Pilot(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="MAGI · PILOT SETUP")
        self.add_css_class("pilot")
        self.set_default_size(760, 560)
        self.set_decorated(False)
        self.level_proc = None
        self.poll = None
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.set_child(root)
        hdr = Gtk.Box(spacing=10)
        hdr.add_css_class("header")
        hdr.append(lbl("MAGI · PILOT SETUP", "title", hexpand=True))
        hdr.append(lbl("ORCHESTRATOR · VOICE · AGENTS", "aux"))
        root.append(hdr)
        hz = Gtk.Box()
        hz.add_css_class("hazard")
        root.append(hz)
        self.stepbox = Gtk.Box(spacing=8, homogeneous=True)
        self.stepbox.add_css_class("steps")
        self.chips = []
        for i, name in enumerate(STEPS):
            c = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            c.add_css_class("step")
            c.append(lbl(f"STEP {i + 1}", "n"))
            c.append(lbl(name, "t"))
            self.chips.append(c)
            self.stepbox.append(c)
        root.append(self.stepbox)
        self.body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, vexpand=True)
        self.body.add_css_class("body")
        root.append(self.body)
        foot = Gtk.Box(spacing=8)
        foot.add_css_class("footer")
        self.status = lbl("", "status", hexpand=True)
        foot.append(self.status)
        self.btns = Gtk.Box(spacing=8)
        foot.append(self.btns)
        root.append(foot)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        self.show_step(int(os.environ.get("MAGI_SETUP_STEP", "1")) - 1)

    # ------------------------------------------------------------ frame
    def on_key(self, _c, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            self.not_now()
            return True
        return False

    def frame(self, i, title, buttons):
        self.cur = i
        self.stop_level()
        if self.poll:
            GLib.source_remove(self.poll)
            self.poll = None
        for j, c in enumerate(self.chips):
            for k in ("cur", "done"):
                c.remove_css_class(k)
            if j < i:
                c.add_css_class("done")
            elif j == i:
                c.add_css_class("cur")
        for box in (self.body, self.btns):
            ch = box.get_first_child()
            while ch:
                nxt = ch.get_next_sibling()
                box.remove(ch)
                ch = nxt
        self.body.append(lbl(title, "h"))
        for b in buttons:
            self.btns.append(b)
        self.say("")

    def say(self, text, kind=None):
        self.status.set_text(text)
        for k in ("err", "ok", "warn"):
            self.status.remove_css_class(k)
        if kind:
            self.status.add_css_class(kind)

    def kv(self, k, v, kind=None):
        b = Gtk.Box(spacing=8)
        b.add_css_class("kv")
        b.append(lbl(k, "k"))
        val = lbl(v, "v", hexpand=True)
        if kind:
            val.add_css_class(kind)
        b.append(val)
        self.body.append(b)
        return val

    def show_step(self, i):
        [self.step_intro, self.step_install, self.step_signin, self.step_voice][max(0, min(3, i))]()

    def not_now(self):
        touch("setup-dismissed")
        self.get_application().quit()

    # ------------------------------------------------------------ 1
    def step_intro(self):
        self.frame(0, "TALK TO ONE AGENT. IT RUNS THE OTHERS.", [
            btn("NOT NOW", self.not_now), btn("SET UP", lambda: self.step_install(), primary=True)])
        for t in [
            "MAGI can run an orchestrator agent (Claude Code, opencode, Codex, or any terminal agent) "
            "in tmux window 1 of the session \"magi\". You speak or type to it. It starts other "
            "agents in their own windows, checks their work, drives the desktop with hyprctl, and "
            "asks you only for decisions.",
            "Local: speech recognition (faster-whisper), the spoken replies (Piper), tmux, the bar "
            "status. Audio never leaves this machine.",
            "Sent to the agent's model provider: the text you say or type to the orchestrator, and "
            "what its agents read and write, as with any session of that agent. You sign in with "
            "your own account.",
            "Open it any time with SUPER+`, the ◉ module in the bar, or the AGENTS page of the "
            "control centre (SUPER+SHIFT+SPACE). SUPER+SHIFT+M mutes the listener.",
        ]:
            self.body.append(lbl(t, "p", wrap=True))
        self.body.append(lbl("Everything here is optional. NOT NOW keeps the plain desktop; "
                             "the AGENTS page can run this setup later.", "dim", wrap=True))

    # ------------------------------------------------------------ 2
    def step_install(self):
        self.frame(1, "PICK THE ORCHESTRATOR AGENT", [
            btn("SKIP", lambda: self.step_signin()),
            btn("INSTALL", self.install, primary=True),
            btn("NEXT", lambda: self.step_signin())])
        self.next_btn = self.btns.get_last_child()
        self.inst_btn = self.next_btn.get_prev_sibling()
        cur = agent_info().get("name", "claude")
        group = None
        self.radios = {}
        for key, title, who in CHOICES:
            row = Gtk.Box(spacing=8)
            row.add_css_class("kv")
            r = Gtk.CheckButton(label=title)
            if group:
                r.set_group(group)
            group = group or r
            r.set_active(key == cur)
            r.connect("toggled", lambda w, k=key: w.get_active() and self.pick(k))
            self.radios[key] = r
            row.append(r)
            row.append(lbl(who, "dim", hexpand=True))
            self.body.append(row)
        self.custom = Gtk.Entry(placeholder_text="command that starts your agent, e.g. aider --model ...")
        self.custom.connect("changed", lambda *_: self.radios["custom"].get_active() and self.pick("custom", typing=True))
        self.body.append(self.custom)
        self.inst_state = self.kv("STATUS", "")
        self.inst_note = lbl("", "p", wrap=True)
        self.body.append(self.inst_note)
        sw = Gtk.ScrolledWindow(vexpand=True)
        self.out = Gtk.TextView(editable=False, monospace=True, cursor_visible=False)
        self.out.set_wrap_mode(Gtk.WrapMode.CHAR)
        sw.set_child(self.out)
        sw.add_css_class("log")
        self.body.append(sw)
        self.pick(cur)

    def pick(self, key, typing=False):
        self.agent = key
        if key == "custom":
            cmd = self.custom.get_text().strip()
            if cmd:
                subprocess.run(["magi-agent", "use", "custom", cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            subprocess.run(["magi-agent", "use", key], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.custom.set_visible(key == "custom")
        info = agent_info(key)
        self.info = info
        path = info.get("path") if info.get("installed") else None
        self.inst_state.set_text(path or ("command not found" if key == "custom" else "not installed"))
        for k in ("good", "warn"):
            self.inst_state.remove_css_class(k)
        self.inst_state.add_css_class("good" if path else "warn")
        if key == "custom":
            self.inst_note.set_text("Any agent that runs in a terminal. It starts in a folder whose AGENTS.md "
                                    "holds MAGI's orchestrator instructions ($MAGI_INSTRUCTIONS has the path). "
                                    "It can't be resumed after a reboot; it starts fresh.")
        else:
            self.inst_note.set_text("MAGI does not include %s. INSTALL runs its official installer for your user, "
                                    "into %s:\n%s\n%s" % (info.get("label"), info.get("install_note"),
                                                          info.get("install_shown"), info.get("licence", "")))
        self.inst_btn.set_sensitive(not path and key != "custom")
        self.next_btn.set_sensitive(bool(path))
        if path:
            self.next_btn.add_css_class("primary")
        else:
            self.next_btn.remove_css_class("primary")

    def install(self):
        self.inst_btn.set_sensitive(False)
        self.say("INSTALLING · %s" % self.info.get("label", "").upper(), "warn")
        buf = self.out.get_buffer()
        proc = Gio.Subprocess.new(["magi-agent", "install", self.agent],
                                  Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
        stream = Gio.DataInputStream.new(proc.get_stdout_pipe())

        def line(s, res):
            try:
                text, _ = s.read_line_finish_utf8(res)
            except GLib.Error:
                text = None
            if text is None:
                return
            buf.insert(buf.get_end_iter(), text + "\n")
            s.read_line_async(GLib.PRIORITY_DEFAULT, None, line)

        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, line)

        def done(p, res):
            p.wait_finish(res)
            if p.get_successful() and agent_info(self.agent).get("installed"):
                self.pick(self.agent)
                self.say("INSTALLED", "ok")
            else:
                self.say("INSTALL FAILED · OFFLINE? TRY AGAIN", "err")
                self.inst_btn.set_sensitive(True)

        proc.wait_async(None, done)

    # ------------------------------------------------------------ 3
    def step_signin(self):
        info = agent_info()
        self.info = info
        self.frame(2, "SIGN IN TO YOUR %s ACCOUNT" % info.get("label", "AGENT").upper(), [
            btn("SKIP", lambda: self.step_voice()),
            btn("OPEN CONSOLE", self.signin, primary=True),
            btn("NEXT", lambda: self.step_voice())])
        self.next_btn = self.btns.get_last_child()
        self.next_btn.set_sensitive(False)
        self.auth_state = self.kv("ACCOUNT", "checking...")
        self.kv("ORCHESTRATOR", "tmux session magi · window 1")
        if info.get("has_signin"):
            text = ("OPEN CONSOLE turns the orchestrator on (it starts at every login from now on) and "
                    "drops down its console. Window 1 runs `%s`: follow the link it prints. This step "
                    "continues by itself once you are signed in." % info.get("login"))
        elif info.get("name") == "opencode":
            text = ("OPEN CONSOLE turns the orchestrator on (it starts at every login from now on) and "
                    "drops down its console. opencode runs without an account on its free models. To "
                    "use your own provider or OpenCode account, type /connect in the console.")
        else:
            text = ("OPEN CONSOLE turns the orchestrator on (it starts at every login from now on) and "
                    "drops down its console. Sign in there however your agent does it.")
        self.body.append(lbl(text, "p", wrap=True))
        self.body.append(lbl("Turn it off later with `magi-agent off` or the AGENTS page.", "dim", wrap=True))
        self.check_auth()
        self.poll = GLib.timeout_add_seconds(2, self.check_auth)

    def signin(self):
        subprocess.Popen(["magi-agent", "on"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.Popen(["hyprctl", "dispatch", 'hl.dsp.workspace.toggle_special("magi")'],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.say("CONSOLE OPEN · SIGN IN THERE", "warn")

    def check_auth(self):
        if not self.info.get("installed"):
            self.info = agent_info()
            if not self.info.get("installed"):
                self.auth_state.set_text("%s not installed (step 2)" % self.info.get("label"))
                return True
        if not self.info.get("has_signin"):
            self.auth_state.set_text("not needed" + (" · /connect in opencode adds one" if self.info.get("name") == "opencode" else ""))
            self.next_btn.set_sensitive(True)
            self.next_btn.add_css_class("primary")
            return False

        def done(p, res):
            try:
                p.wait_finish(res)
                ok = p.get_successful()
            except GLib.Error:
                ok = False
            if ok:
                self.auth_state.set_text("SIGNED IN")
                self.auth_state.add_css_class("good")
                self.next_btn.set_sensitive(True)
                self.next_btn.add_css_class("primary")
                self.say("SIGNED IN", "ok")
            else:
                self.auth_state.set_text("not signed in")

        p = Gio.Subprocess.new([sys.executable, AGENTS_PY, "signed-in"],
                               Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE)
        p.wait_async(None, done)
        return True

    # ------------------------------------------------------------ 4
    def step_voice(self):
        self.frame(3, "VOICE · LOCAL ONLY", [
            btn("TEST MIC", self.test_mic), btn("TEST VOICE", self.test_voice),
            btn("FINISH", self.finish, primary=True)])
        self.body.append(lbl(
            "The listener types what you say into the orchestrator as [voice] ... There is no wake "
            "word: it hears the room, so mute it on calls (SUPER+SHIFT+M). Speech recognition and "
            "the spoken replies run on this machine.", "p", wrap=True))
        row = Gtk.Box(spacing=8)
        row.add_css_class("kv")
        row.append(lbl("MICROPHONE", "k"))
        self.srcs = sources() or [("", "default")]
        self.mic = Gtk.DropDown.new_from_strings([d for _, d in self.srcs])
        self.mic.set_hexpand(True)
        pref = next((i for i, (n, _) in enumerate(self.srcs) if n.startswith("alsa_input")), 0)
        self.mic.set_selected(pref)
        self.mic.connect("notify::selected", lambda *_: self.start_level())
        row.append(self.mic)
        self.body.append(row)
        row = Gtk.Box(spacing=8)
        row.add_css_class("kv")
        row.append(lbl("LEVEL", "k"))
        self.meter = Gtk.LevelBar(min_value=0, max_value=100, hexpand=True, valign=Gtk.Align.CENTER)
        row.append(self.meter)
        self.body.append(row)
        self.heard = self.kv("HEARD", "TEST MIC records 4 s and shows the transcript")
        row = Gtk.Box(spacing=8)
        row.add_css_class("kv")
        row.append(lbl("LISTEN AT LOGIN", "k"))
        self.listen_sw = Gtk.Switch(active=True, halign=Gtk.Align.START)
        row.append(self.listen_sw)
        self.body.append(row)
        self.start_level()

    def source(self):
        i = self.mic.get_selected()
        return self.srcs[i][0] if 0 <= i < len(self.srcs) else ""

    def start_level(self):
        self.stop_level()
        env = dict(os.environ, HUD_SOURCE=self.source()) if self.source() else None
        try:
            self.level_proc = subprocess.Popen(["magi-listen", "--level"], stdout=subprocess.PIPE, text=True, env=env)
        except OSError:
            return
        ch = GLib.IOChannel.unix_new(self.level_proc.stdout.fileno())

        def read(_c, cond):
            line = self.level_proc.stdout.readline() if self.level_proc else ""
            if not line:
                return False
            try:
                self.meter.set_value(float(line))
            except ValueError:
                pass
            return True

        GLib.io_add_watch(ch, GLib.PRIORITY_DEFAULT, GLib.IOCondition.IN | GLib.IOCondition.HUP, read)

    def stop_level(self):
        if self.level_proc:
            self.level_proc.terminate()
            self.level_proc = None

    def test_mic(self):
        self.heard.set_text("listening for 4 s... speak now")
        self.say("RECORDING", "warn")
        env = dict(os.environ)
        if self.source():
            env["HUD_SOURCE"] = self.source()
        launcher = Gio.SubprocessLauncher.new(Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
        for k, v in env.items():
            launcher.setenv(k, v, True)
        p = launcher.spawnv(["magi-listen", "--once", "4"])

        def done(p, res):
            try:
                _, out, _ = p.communicate_utf8_finish(res)
            except GLib.Error:
                out = ""
            self.heard.set_text((out or "").strip() or "(nothing heard)")
            self.say("LOCAL TRANSCRIPT", "ok")

        p.communicate_utf8_async(None, None, done)

    def test_voice(self):
        subprocess.Popen(["hud-say", "MAGI voice online. Say what you want done."],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.say("SPEAKING · LOCAL PIPER VOICE", "ok")

    def finish(self):
        self.stop_level()
        if self.source():
            set_conf("SOURCE", self.source())
        on = self.listen_sw.get_active()
        set_conf("VOICE", "1" if on else "0")
        subprocess.run(["magi-agent", "voice", "on" if on else "off"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        touch("setup-done")
        subprocess.Popen(["notify-send", "-a", "MAGI", "PILOT SETUP COMPLETE",
                          "SUPER+` opens the orchestrator. " + ("Say what you want done." if on else "Type what you want done.")],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.get_application().quit()


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="magi.pilot.setup", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        prov = Gtk.CssProvider()
        prov.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        win = self.get_active_window() or Pilot(self)
        win.present()


if __name__ == "__main__":
    GLib.set_prgname("magi-pilot-setup")
    sys.exit(App().run([sys.argv[0]]))

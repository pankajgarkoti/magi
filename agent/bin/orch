#!/usr/bin/env python3
"""orch: the orchestrator's ledger and health check.

The notes folder (~/notes, NOTES_DIR in ~/.config/magi/agent.conf) is a local git repository:

  templates/daily.md                 the daily-note template: # Tasks, # Notes, # Logs, # Scratch
  Journal/YYYY/MM/YYYY-MM-DD.md      one note a day. The orchestrator writes open threads under
                                     "## Open threads" (inside # Tasks; tick a box to close it),
                                     voice action items as "## From voice (...)" sections, and
                                     decisions, deliverables and finished agents under # Logs
  orchestrator/orch.db               the ledger (SQLite, WAL; one backup a day in backups/, 14 kept)
  orchestrator/briefs/DATE/NAME.md   every brief given to an agent through `orch spawn`
  orchestrator/system/               the orchestrator layer (scripts, units, ORCHESTRATOR.md),
                                     copied from the image and symlinked into ~/.local/bin and
                                     ~/.config/systemd/user by system/install.sh

`orch doctor` commits changes to the notes repo (local commits only; nothing is pushed).

Tables
  agents        agent windows started through `orch spawn`: name, pane, cwd, brief, status, result
  threads       open threads (work or decisions not yet addressed); the human view is the daily
                note's "## Open threads" checklist: tick a box there to close it
  watchers      probes, monitors and other standing watches: what, why, until when, last seen working
  decisions     the user's decisions, so nothing is asked twice
  deliverables  PRs, deploys, releases, messages sent
  nudges        timed messages put on the bus (open threads)
  events        a mirror of the event bus log (~/.local/state/orchestrator/events.jsonl)

Commands (idempotent; none blocks for more than a few seconds)
  orch init                                  set up the notes repo, ledger and system/ (idempotent)
  orch spawn NAME DIR BRIEF [--task T] [--agent A]   copy the brief, magi-agent spawn, ledger row
  orch agent done|lost NAME [--result R]
  orch agents [--all]                        running agents (or all)
  orch thread add "line" [details on stdin] | scan | count
  orch watch add NAME KIND PURPOSE [--cmd C] [--until ISO] | ok NAME | end NAME
  orch watches
  orch decide "text" [--context C]           log a decision of the user's
  orch deliver KIND REF "title" [--url U]    log a PR / deploy / release / message
  orch sync                                  ingest new bus events, ticked threads, closed windows
  orch status [--brief]                      one-screen summary
  orch up                                    start everything: tmux session, core windows, doctor
  orch doctor [--quiet]                      check every piece, fix what is safe, report the rest on the bus
  orch nudge-threads                         (orch-open-threads.timer, every 3 h) remind the orchestrator of open threads
  orch voice-digest                          (voice-digest.timer) action items from what the listener heard -> daily note
  orch system update                         refresh notes/orchestrator/system from the image, re-link, commit
  orch note [today|path]                     today's daily note (created from the template); print its path
"""
import datetime as dt, hashlib, json, os, pathlib, re, shutil, sqlite3, subprocess, sys, time

HOME = pathlib.Path.home()
DATA = pathlib.Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "magi"
STATE_HOME = pathlib.Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state"))
CONF = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "magi/agent.conf"


def _notes_dir():
    v = os.environ.get("ORCH_NOTES")
    try:
        for line in CONF.read_text().splitlines():
            if line.startswith("NOTES_DIR=") and not v:
                v = line.split("=", 1)[1].strip().strip("'\"")
    except OSError:
        pass
    return pathlib.Path(os.path.expanduser(v or "~/notes"))


NOTES = _notes_dir()
ROOT = NOTES / "orchestrator"
DB = ROOT / "orch.db"
BACKUPS = ROOT / "backups"
BRIEFS = ROOT / "briefs"
SYSDIR = ROOT / "system"
TEMPLATE = NOTES / "templates/daily.md"
OLD_DB, OLD_THREADS = DATA / "orch.db", DATA / "threads.md"   # 0.2.0 locations, migrated by init
VOICE = STATE_HOME / "magi/voice"
IMAGE_AGENT = pathlib.Path("/usr/share/magi/agent")
BUS = STATE_HOME / "orchestrator/events.jsonl"
BB_STATUS = STATE_HOME / "browser-bus/status.json"
REAP_LOG = STATE_HOME / "tmux-reap/closed.log"
SESSION = "magi"
PORT = int(os.environ.get("MAGI_BROWSER_PORT", 9222))
HERE = pathlib.Path(os.path.realpath(__file__)).parent

SCHEMA = """
CREATE TABLE IF NOT EXISTS agents(
  id INTEGER PRIMARY KEY, name TEXT NOT NULL, pane TEXT, cwd TEXT, brief_path TEXT, task TEXT, agent TEXT,
  status TEXT NOT NULL DEFAULT 'running', result TEXT, resume_cmd TEXT,
  started_at TEXT NOT NULL, ended_at TEXT, updated_at TEXT NOT NULL);
CREATE INDEX IF NOT EXISTS agents_status ON agents(status, started_at);
CREATE TABLE IF NOT EXISTS threads(
  id INTEGER PRIMARY KEY, raised_at TEXT NOT NULL, line TEXT NOT NULL UNIQUE, details TEXT,
  source TEXT NOT NULL DEFAULT 'orchestrator', status TEXT NOT NULL DEFAULT 'open', resolved_at TEXT);
CREATE TABLE IF NOT EXISTS watchers(
  id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE, kind TEXT NOT NULL, purpose TEXT NOT NULL, cmd TEXT,
  started_at TEXT NOT NULL, until TEXT, last_ok_at TEXT, status TEXT NOT NULL DEFAULT 'active', ended_at TEXT);
CREATE TABLE IF NOT EXISTS decisions(id INTEGER PRIMARY KEY, at TEXT NOT NULL, text TEXT NOT NULL, context TEXT);
CREATE TABLE IF NOT EXISTS deliverables(
  id INTEGER PRIMARY KEY, at TEXT NOT NULL, kind TEXT NOT NULL, ref TEXT NOT NULL, title TEXT NOT NULL, url TEXT,
  UNIQUE(kind, ref));
CREATE TABLE IF NOT EXISTS events(
  id INTEGER PRIMARY KEY, at REAL, ts TEXT, source TEXT, text TEXT, line_no INTEGER NOT NULL UNIQUE);
CREATE TABLE IF NOT EXISTS nudges(id INTEGER PRIMARY KEY, at TEXT NOT NULL, kind TEXT NOT NULL, text TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS meta(k TEXT PRIMARY KEY, v TEXT);
"""

# What the doctor expects. User units enabled for everyone in the image (systemctl --global):
ALWAYS_UNITS = ["orch-bus.service", "browser-bus.service", "orch-doctor.timer", "orch-open-threads.timer",
                "tmux-snapshot.timer", "voice-digest.timer", "tmux-restore.service"]
# ... and the ones `magi-agent on` enables:
AGENT_UNITS = ["magi-agents.service", "tmux-reap-stale.timer"]
ONESHOT = {"magi-agents.service", "tmux-restore.service"}  # run once at login; only check that it is enabled
SCRIPTS = ["orch-bus", "browser-bus", "chrome-debug", "magi-agent", "tmux-snapshot", "tmux-restore", "tmux-reap-stale"]
# Core windows of session magi and what runs in them (magi-agent start creates them).
WINDOWS = {"orchestrator": None, "bus": "orch-bus live", "chrome": "chrome-debug"}


def now():
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def conf():
    c = {}
    try:
        for line in CONF.read_text().splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                c[k.strip()] = v.strip().strip("'\"")
    except OSError:
        pass
    return c


def db():
    ROOT.mkdir(parents=True, exist_ok=True)
    if not DB.exists() and OLD_DB.exists():  # 0.2.0 kept the ledger in ~/.local/share/magi
        src, dst = sqlite3.connect(OLD_DB), sqlite3.connect(DB)
        src.backup(dst)
        dst.close(); src.close()
        OLD_DB.rename(OLD_DB.with_suffix(".db.moved-to-notes"))
    c = sqlite3.connect(DB, timeout=10)
    c.row_factory = sqlite3.Row
    c.execute("PRAGMA journal_mode=WAL")
    c.execute("PRAGMA busy_timeout=10000")
    c.executescript(SCHEMA)
    if "note_day" not in [r[1] for r in c.execute("PRAGMA table_info(threads)")]:
        c.execute("ALTER TABLE threads ADD COLUMN note_day TEXT")
    return c


def sh(*a, timeout=10):  # every external call is bounded
    try:
        r = subprocess.run(a, capture_output=True, text=True, timeout=timeout)
        return r.stdout if r.returncode == 0 else ""
    except Exception:
        return ""


def tool(name):
    p = shutil.which(name) or shutil.which(name, path=str(HOME / ".local/bin"))
    return p or str(HERE / name)


def bus(source, text):
    subprocess.run([tool("orch-bus"), "emit", source, text], capture_output=True, timeout=10)


def panes():
    """window name -> (pane id, window index) for session magi."""
    out = {}
    for line in sh("tmux", "list-panes", "-s", "-t", f"={SESSION}", "-F", "#{window_name}\t#{window_index}\t#{pane_id}").splitlines():
        w, i, p = line.split("\t")
        out.setdefault(w, (p, int(i)))
    return out


def opt(args, flag, default=None):
    return args[args.index(flag) + 1] if flag in args and args.index(flag) + 1 < len(args) else default


def positional(args, flags=("--task", "--agent", "--result", "--cmd", "--until", "--context", "--url", "--source")):
    out, skip = [], False
    for a in args:
        if skip:
            skip = False
        elif a in flags:
            skip = True
        else:
            out.append(a)
    return out


# ---------------------------------------------------------------- agents
def spawn(args):
    pos = positional(args)
    if len(pos) < 3:
        sys.exit("usage: orch spawn NAME DIR BRIEF [--task T] [--agent A]")
    name, cwd, brief = pos[0], os.path.abspath(os.path.expanduser(pos[1])), pos[2]
    day = dt.date.today().isoformat()
    (BRIEFS / day).mkdir(parents=True, exist_ok=True)
    dest = BRIEFS / day / f"{name}.md"
    text = pathlib.Path(os.path.expanduser(brief)).read_text() if os.path.isfile(os.path.expanduser(brief)) else brief
    dest.write_text(text)
    if name in panes():
        sys.exit(f"window {name} already exists in session {SESSION}")
    cmd = [tool("magi-agent"), "spawn", name, cwd, str(dest)]
    if opt(args, "--agent"):
        cmd += ["--agent", opt(args, "--agent")]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    print(r.stdout.strip() or r.stderr.strip())
    if r.returncode:
        return r.returncode
    c = db()
    c.execute("INSERT INTO agents(name,pane,cwd,brief_path,task,agent,started_at,updated_at) VALUES(?,?,?,?,?,?,?,?)",
              (name, panes().get(name, (None,))[0], cwd, str(dest),
               opt(args, "--task") or (text.strip().splitlines() or [""])[0][:200], opt(args, "--agent"), now(), now()))
    c.commit()
    print(f"ledger: {name} recorded, brief {dest}")
    return 0


def agent_set(args):
    status, name = args[0], args[1]
    c = db()
    row = c.execute("SELECT id FROM agents WHERE name=? AND status='running' ORDER BY id DESC LIMIT 1", (name,)).fetchone()
    if row:
        c.execute("UPDATE agents SET status=?, result=COALESCE(?,result), ended_at=?, updated_at=? WHERE id=?",
                  (status, opt(args, "--result"), now(), now(), row["id"]))
    else:
        c.execute("INSERT INTO agents(name,status,result,started_at,ended_at,updated_at) VALUES(?,?,?,?,?,?)",
                  (name, status, opt(args, "--result"), now(), now(), now()))
    c.commit()
    note_log(f"agent {name} {status}" + (f": {opt(args, '--result')}" if opt(args, "--result") else ""))


def agents_list(args):
    q = "SELECT * FROM agents" + ("" if "--all" in args else " WHERE status='running'") + " ORDER BY id DESC LIMIT 50"
    for r in db().execute(q):
        print(f"{r['started_at'][:16]}  {r['status']:8} {r['name']:18} {r['pane'] or '':5} {(r['task'] or '')[:90]}")


# ---------------------------------------------------------------- daily notes
DEFAULT_TEMPLATE = """---
template_version: 1
---

# Tasks

- [ ]

# Notes

# Logs

# Scratch
"""
HEAD = "## Open threads"


def note_path(day=None):
    day = day or dt.date.today()
    return NOTES / f"Journal/{day:%Y}/{day:%m}/{day:%Y-%m-%d}.md"


def note_lines(day=None):
    p = note_path(day)
    if not p.exists():
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(TEMPLATE.read_text() if TEMPLATE.exists() else DEFAULT_TEMPLATE)
    return p.read_text().split("\n")


def _section_end(lines, start, level):
    """Index after the last line of the section that starts at `start` (a heading of `level` #s)."""
    j = start + 1
    while j < len(lines) and not re.match(r"#{1,%d} " % level, lines[j]):
        j += 1
    while j > start + 1 and lines[j - 1].strip() == "":
        j -= 1
    return j


def note_insert(items, top="# Tasks", sub=None, day=None):
    """Append lines to section `top` (and its "## sub" subsection, created if missing) of a daily note."""
    lines = note_lines(day)
    if top not in lines:
        lines += ["", top, ""]
    t = lines.index(top)
    if sub:
        end = _section_end(lines, t, 1)
        idx = next((i for i in range(t + 1, end) if lines[i] == sub), None)
        if idx is None:
            lines[end:end] = ["", sub]
            idx = end + 1
        k = _section_end(lines, idx, 2)
    else:
        k = _section_end(lines, t, 1)
    if lines[k - 1].strip() == "- [ ]":  # the template's empty first task
        k -= 1
        del lines[k]
    lines[k:k] = items
    note_path(day).write_text("\n".join(lines))
    return note_path(day)


def note_log(text):
    """One line under # Logs of today's note."""
    note_insert([f"- {dt.datetime.now():%H:%M} · {' '.join(text.split())}"], top="# Logs")


def note_cmd(args):
    note_lines()
    print(note_path())


# ---------------------------------------------------------------- threads (the daily note is the human view)
def thread_cmd(args):
    sub = args[0] if args else "scan"
    if sub == "add":
        line = " ".join(args[1].split())
        details = "" if sys.stdin.isatty() else sys.stdin.read()
        day = dt.date.today()
        if not any(l.startswith("- [") and line in l for l in note_lines()):
            item = f"- [ ] {dt.datetime.now():%H:%M} · {line}"
            if details.strip():
                side = note_path().with_name(f"{day:%Y-%m-%d}.threads.md")
                anchor = f"{dt.datetime.now():%H%M%S}"
                new = not side.exists()
                with side.open("a") as f:
                    if new:
                        f.write(f"# Open-thread details · {day}\n\nLinked from [[{note_path().stem}]] → {HEAD}.\n")
                    f.write(f"\n## {anchor}\n{dt.datetime.now():%Y-%m-%d %H:%M} · {line}\n\n{details.rstrip()}\n")
                item += f" ([[{side.stem}#{anchor}|details]])"
            note_insert([item], top="# Tasks", sub=HEAD)
        c = db()
        c.execute("INSERT OR IGNORE INTO threads(raised_at,note_day,line,details,source) VALUES(?,?,?,?,?)",
                  (now(), day.isoformat(), line, details, opt(args, "--source", "orchestrator")))
        c.commit()
        print(note_path())
        return
    sync_threads()
    rows = db().execute("SELECT raised_at,note_day,line FROM threads WHERE status='open' ORDER BY id DESC").fetchall()
    if sub == "count":
        print(len(rows))
    else:
        for r in rows:
            print(f"{r['note_day'] or r['raised_at'][:10]}  {r['line']}   [{note_path(dt.date.fromisoformat(r['note_day'])) if r['note_day'] else ''}]")


def sync_threads(days=30):
    """Mirror the "## Open threads" checkboxes of the last `days` daily notes into the ledger:
    a ticked box there closes the thread here."""
    c = db()
    today = dt.date.today()
    for n in range(days):
        day = today - dt.timedelta(days=n)
        p = note_path(day)
        if not p.exists():
            continue
        inside = False
        for ln in p.read_text().split("\n"):
            if ln.startswith("#"):
                inside = ln.strip() == HEAD
                continue
            m = re.match(r"- \[( |x|X)\] (.*)", ln) if inside else None
            if not m:
                continue
            line = re.sub(r"^\d\d:\d\d · ", "", m.group(2)).split(" ([[")[0].strip()
            ticked = m.group(1) != " "
            c.execute("INSERT OR IGNORE INTO threads(raised_at,note_day,line,source) VALUES(?,?,?,'note')", (now(), day.isoformat(), line))
            c.execute("UPDATE threads SET note_day=COALESCE(note_day,?), status=?, resolved_at=CASE WHEN ? THEN COALESCE(resolved_at,?) ELSE NULL END WHERE line=?",
                      (day.isoformat(), "done" if ticked else "open", ticked, now(), line))
    c.commit()


# ---------------------------------------------------------------- watchers / decisions / deliverables
def watch_cmd(args):
    c = db()
    sub = args[0]
    if sub == "add":
        p = positional(args[1:])
        name, kind, purpose = p[0], p[1], p[2]
        c.execute("INSERT INTO watchers(name,kind,purpose,cmd,started_at,until,last_ok_at,status) VALUES(?,?,?,?,?,?,?,'active') "
                  "ON CONFLICT(name) DO UPDATE SET kind=excluded.kind, purpose=excluded.purpose, cmd=excluded.cmd, "
                  "started_at=excluded.started_at, until=excluded.until, status='active', ended_at=NULL",
                  (name, kind, purpose, opt(args, "--cmd"), now(), opt(args, "--until"), now()))
    elif sub == "ok":
        c.execute("UPDATE watchers SET last_ok_at=? WHERE name=?", (now(), args[1]))
    elif sub == "end":
        c.execute("UPDATE watchers SET status='ended', ended_at=? WHERE name=?", (now(), args[1]))
    c.commit()


def watches(_):
    for r in db().execute("SELECT * FROM watchers WHERE status='active' ORDER BY kind, name"):
        print(f"{r['kind']:10} {r['name']:24} until {r['until'] or '-':20} last ok {(r['last_ok_at'] or '-')[:16]}  {r['purpose'][:80]}")


def decide(args):
    c = db()
    c.execute("INSERT INTO decisions(at,text,context) VALUES(?,?,?)", (now(), args[0], opt(args, "--context")))
    c.commit()
    note_log(f"decision: {args[0]}")


def deliver(args):
    c = db()
    c.execute("INSERT OR REPLACE INTO deliverables(at,kind,ref,title,url) VALUES(?,?,?,?,?)",
              (now(), args[0], args[1], args[2], opt(args, "--url")))
    c.commit()
    note_log(f"{args[0]} {args[1]}: {args[2]}" + (f" ({opt(args, '--url')})" if opt(args, "--url") else ""))


# ---------------------------------------------------------------- sync / status
def sync(_=None):
    c = db()
    if BUS.exists():
        last = int((c.execute("SELECT v FROM meta WHERE k='bus_lines'").fetchone() or {"v": 0})["v"])
        lines = BUS.read_text(errors="replace").splitlines()
        if len(lines) < last:  # the log was trimmed: count from its new start
            last = 0
        base = int(c.execute("SELECT COALESCE(MAX(line_no),0) m FROM events").fetchone()["m"])
        for i, ln in enumerate(lines[last:], start=1):
            try:
                e = json.loads(ln)
            except ValueError:
                continue
            c.execute("INSERT OR IGNORE INTO events(at,ts,source,text,line_no) VALUES(?,?,?,?,?)",
                      (e.get("at"), e.get("ts"), e.get("source"), e.get("text"), base + i))
        c.execute("INSERT OR REPLACE INTO meta(k,v) VALUES('bus_lines',?)", (str(len(lines)),))
    # reaper log: "<date> <time>  <window>  <agent>  idle <n>m  resume: <command> | can't resume (...)"
    if REAP_LOG.exists():
        for ln in REAP_LOG.read_text(errors="replace").splitlines():
            m = re.match(r"(\S+ \S+)\s+(\S+)\s+\S+\s+idle \d+m\s+(.*)", ln)
            if not m:
                continue
            at, name, resume = m.groups()
            resume = resume.removeprefix("resume: ")
            c.execute("UPDATE agents SET status='reaped', resume_cmd=?, ended_at=?, updated_at=? WHERE name=? AND status='running' "
                      "AND started_at < ?", (resume, at, now(), name, at.replace(" ", "T")))
    # running agents whose window is gone -> lost, plus an open thread so it is not forgotten
    live = panes()
    if live:  # no tmux server at all (early boot) is not evidence that windows were lost
        for r in c.execute("SELECT id,name,task FROM agents WHERE status='running'").fetchall():
            if r["name"] not in live:
                c.execute("UPDATE agents SET status='lost', ended_at=?, updated_at=? WHERE id=?", (now(), now(), r["id"]))
                c.commit()
                subprocess.run([sys.executable, __file__, "thread", "add",
                                f"{r['name']}: window closed while its task was open · {(r['task'] or '')[:120]}"],
                               input="", text=True, capture_output=True, timeout=20)
    c.commit()
    sync_threads()


def status(args):
    sync()
    c = db()
    brief = "--brief" in args
    run = c.execute("SELECT name,pane,task,started_at FROM agents WHERE status='running' ORDER BY id").fetchall()
    th = c.execute("SELECT raised_at,line FROM threads WHERE status='open' ORDER BY id DESC").fetchall()
    w = c.execute("SELECT kind,name,purpose,until FROM watchers WHERE status='active' ORDER BY kind,name").fetchall()
    dec = c.execute("SELECT at,text FROM decisions ORDER BY id DESC LIMIT 8").fetchall()
    doc = (c.execute("SELECT v FROM meta WHERE k='doctor_last'").fetchone() or {"v": "never"})["v"]
    out = [f"ORCH STATUS {now()[:16]} · ledger {DB} · doctor {doc}"]
    out.append(f"Agents running ({len(run)}):")
    out += [f"  {r['name']} {r['pane'] or ''} since {r['started_at'][11:16]} · {(r['task'] or '')[:100]}" for r in run] or ["  none"]
    out.append(f"Open threads ({len(th)}):")
    out += [f"  {r['raised_at'][:10]} · {r['line'][:140]}" for r in th[: (10 if brief else 100)]] or ["  none"]
    out.append(f"Active watchers ({len(w)}):")
    out += [f"  {r['kind']} {r['name']} · {r['purpose'][:90]}" + (f" (until {r['until']})" if r['until'] else "") for r in w] or ["  none"]
    out.append("Recent decisions:")
    out += [f"  {r['at'][:16]} · {r['text'][:140]}" for r in dec] or ["  none"]
    print("\n".join(out))


# ---------------------------------------------------------------- doctor
def unit_ok(u):
    return sh("systemctl", "--user", "is-active", u).strip() == "active"


def doctor(args):
    quiet = "--quiet" in args
    c_ = conf()
    agent_on = c_.get("ENABLED") == "1"
    browser_on = c_.get("BROWSER", "1") != "0"
    problems, fixed = [], []
    units = ALWAYS_UNITS + (AGENT_UNITS if agent_on else [])
    for u in units:
        if u == "browser-bus.service" and not browser_on:
            continue
        if u in ONESHOT:
            if sh("systemctl", "--user", "is-enabled", u).strip() != "enabled":
                subprocess.run(["systemctl", "--user", "enable", u], capture_output=True, timeout=15)
                (fixed if sh("systemctl", "--user", "is-enabled", u).strip() == "enabled" else problems).append(f"unit {u} (enabled)")
            continue
        if not unit_ok(u):
            subprocess.run(["systemctl", "--user", "start", "--no-block", u], capture_output=True, timeout=15)
            time.sleep(1)
            (fixed if unit_ok(u) else problems).append(f"unit {u} restarted" if unit_ok(u) else f"unit {u} not running")
    for s in SCRIPTS:
        if not os.access(tool(s), os.X_OK):
            problems.append(f"{s} not found")
    if agent_on:
        live = panes()
        if not live:
            problems.append(f"tmux session {SESSION} is not running (magi-agent start)")
        else:
            for w, prog in WINDOWS.items():
                if w == "chrome" and not browser_on:
                    continue
                if w not in live:
                    subprocess.run([tool("magi-agent"), "start"], capture_output=True, timeout=60)
                    (fixed if w in panes() else problems).append(f"window {w} " + ("recreated" if w in panes() else "missing"))
        if browser_on:
            up = lambda: sh("curl", "-s", "--max-time", "3", f"http://127.0.0.1:{PORT}/json/version")
            pane = panes().get("chrome", (None,))[0]
            if not up() and pane:
                # chrome-debug gave up (no display yet at boot, or Chromium was closed): the window is a
                # bare shell now. Start it again in the same window.
                cur = sh("tmux", "display-message", "-p", "-t", pane, "#{pane_current_command}").strip()
                if cur in ("bash", "zsh", "sh", "fish", ""):
                    subprocess.run(["tmux", "respawn-pane", "-k", "-t", pane, "chrome-debug; exec bash"], capture_output=True, timeout=10)
                    for _ in range(15):
                        if up():
                            break
                        time.sleep(1)
                    if up():
                        fixed.append("agent browser restarted in window chrome")
            if not up():
                problems.append(f"agent browser not answering on 127.0.0.1:{PORT} (tmux window 'chrome' runs chrome-debug)")
            else:
                try:
                    st = json.loads(BB_STATUS.read_text())
                    for _ in range(35 if not st.get("connected") else 0):  # it reconnects within 30 s
                        time.sleep(1)
                        st = json.loads(BB_STATUS.read_text())
                        if st.get("connected"):
                            break
                    if not st.get("connected"):
                        problems.append("browser-bus is not connected to the agent browser")
                except (OSError, ValueError):
                    problems.append("browser-bus has written no status yet")
    if c_.get("VOICE", "1") == "1" and agent_on and "listen" in panes():
        if "MUTED" in sh("wpctl", "get-volume", "@DEFAULT_AUDIO_SOURCE@"):
            problems.append("the default microphone is muted, so the listener hears nothing")
    try:
        c = db()
        ok = c.execute("PRAGMA integrity_check").fetchone()[0]
        if ok != "ok":
            problems.append(f"ledger integrity: {ok}")
    except Exception as e:
        problems.append(f"ledger unusable: {e}")
    try:
        BUS.parent.mkdir(parents=True, exist_ok=True)
        with BUS.open("a"):
            pass
    except OSError as e:
        problems.append(f"bus not writable: {e}")
    for r in db().execute("SELECT name,until FROM watchers WHERE status='active' AND until IS NOT NULL AND until < ?", (now(),)):
        problems.append(f"watcher {r['name']} passed its end time {r['until']}: end it or extend it")
    # notes repo and the system layer linked from it
    if not (NOTES / ".git").exists():
        init(["--quiet"])
        (fixed if (NOTES / ".git").exists() else problems).append(f"notes repo set up at {NOTES}")
    if (SYSDIR / "agent").exists():
        bad = link_problems()
        if bad:
            problems.append(f"not linked from {SYSDIR}: {', '.join(bad[:5])}")
        have = (SYSDIR / "VERSION").read_text().strip() if (SYSDIR / "VERSION").exists() else ""
        if have and have != image_version():
            # After an image update: refresh system/ by itself, unless the user has edited it
            # (uncommitted changes, or a commit there that isn't one of orch's own).
            dirty = git("status", "--porcelain", "--", "orchestrator/system").stdout.strip()
            last = git("log", "-1", "--format=%s", "--", "orchestrator/system").stdout.strip()
            if not dirty and last.startswith("system: orchestrator layer from"):
                system_update(quiet=True)
                fixed.append(f"orchestrator layer in the notes updated to {image_version()}")
            else:
                problems.append(f"the image has a newer orchestrator layer ({image_version()}); system/ in the notes has your edits "
                                f"(version {have}): merge, or run `orch system update` to replace them")
    note_lines()  # today's daily note exists
    backup()
    sync()
    # Report on the bus only when the set of problems changes, so a lasting problem is said once,
    # not every 15 minutes.
    c = db()
    sig = hashlib.sha1("\n".join(sorted(problems)).encode()).hexdigest()[:12]
    prev = (c.execute("SELECT v FROM meta WHERE k='doctor_sig'").fetchone() or {"v": ""})["v"]
    if problems and sig != prev:
        bus("orch-doctor", "PROBLEMS: " + "; ".join(problems))
    elif not problems and prev and prev != hashlib.sha1(b"").hexdigest()[:12]:
        bus("orch-doctor", "all checks pass again")
    if fixed:
        bus("orch-doctor", "fixed: " + "; ".join(fixed))
    c.execute("INSERT OR REPLACE INTO meta(k,v) VALUES('doctor_sig',?)", (sig,))
    c.execute("INSERT OR REPLACE INTO meta(k,v) VALUES('doctor_last',?)", (now()[:16] + (" OK" if not problems else f" {len(problems)} problems"),))
    c.commit()
    c.close()
    commit_notes()  # last, so the ledger rows written above are part of the commit
    if not quiet or problems:
        print("doctor:", "OK" if not problems else "PROBLEMS:\n  " + "\n  ".join(problems), ("\nfixed: " + ", ".join(fixed)) if fixed else "")
    return 1 if problems else 0


def backup():
    """One consistent copy per day (sqlite backup API), 14 kept."""
    BACKUPS.mkdir(parents=True, exist_ok=True)
    dest = BACKUPS / f"orch-{dt.date.today():%Y%m%d}.db"
    if not dest.exists():
        src, dst = db(), sqlite3.connect(dest)
        src.backup(dst)
        dst.close()
    for old in sorted(BACKUPS.glob("orch-*.db"))[:-14]:
        old.unlink()


def up(_):
    subprocess.run([tool("magi-agent"), "start"], capture_output=True, timeout=120)
    rc = doctor(["--quiet"])
    msg = f"orch up: windows {', '.join(panes()) or 'none'}; doctor {'OK' if rc == 0 else 'found problems'}"
    bus("orch", msg)
    print(msg)


def nudge_threads(_):
    for f in (REAP_LOG, BUS):  # cap the logs at their last 5000 lines
        try:
            lines = f.read_text(errors="replace").splitlines()
            if len(lines) > 5000:
                tmp = f.with_suffix(".tmp")
                tmp.write_text("\n".join(lines[-5000:]) + "\n")
                os.replace(tmp, f)
        except OSError:
            pass
    sync_threads()
    n = db().execute("SELECT COUNT(*) n FROM threads WHERE status='open'").fetchone()["n"]
    if not n:
        return
    msg = (f"[open-threads] {n} open thread{'s' if n != 1 else ''} in the daily notes, including agents closed while idle. "
           f"Run `orch thread scan`, raise every one with the user in plain words and ask what to do; "
           f"tick it under '{HEAD}' in its daily note once it is addressed.")
    bus("open-threads", msg)
    c = db()
    c.execute("INSERT INTO nudges(at,kind,text) VALUES(?,?,?)", (now(), "open-threads", msg))
    c.commit()


# ---------------------------------------------------------------- notes repo: git, system layer
SYS_INSTALL = """#!/usr/bin/env bash
# Link the orchestrator layer from this notes repo into place: scripts into ~/.local/bin, user
# units into ~/.config/systemd/user, then enable the units units.json marks "enabled".
# The notes repo is the source of truth: edit here (or at the linked path; it is the same file)
# and commit. `orch system update` refreshes agent/ from the mAGI image. Safe to run twice.
set -euo pipefail
S=$(cd "$(dirname "$0")" && pwd)
mkdir -p ~/.local/bin ~/.config/systemd/user
ln_s() { if [ -e "$2" ] && [ ! -L "$2" ]; then mv "$2" "$2.pre-notes.$(date +%s)"; fi; ln -sfn "$1" "$2"; }
for f in "$S"/agent/bin/*; do ln_s "$f" ~/.local/bin/"$(basename "$f")"; done
for f in "$S"/agent/systemd/*; do ln_s "$f" ~/.config/systemd/user/"$(basename "$f")"; done
systemctl --user daemon-reload 2>/dev/null || true
python3 - "$S/units.json" <<'PY' | while read -r u; do systemctl --user enable "$u" >/dev/null 2>&1 || true; done
import json, sys
print("\\n".join(u for u, v in json.load(open(sys.argv[1])).items() if v == "enabled"))
PY
echo "linked $(ls "$S"/agent/bin | wc -l) scripts and $(ls "$S"/agent/systemd | wc -l) units from $S"
"""
UNIT_STATES = {u: "enabled" for u in ALWAYS_UNITS}


def git(*a, timeout=30):
    return subprocess.run(["git", "-C", str(NOTES), *a], capture_output=True, text=True, timeout=timeout)


def commit_notes(msg=None):
    """Local commit of everything changed in the notes repo; never pushes. Returns the file count."""
    if not (NOTES / ".git").exists():
        return 0
    try:
        db().execute("PRAGMA wal_checkpoint(TRUNCATE)")  # orch.db self-contained in the commit
    except Exception:
        pass
    changed = [l[3:] for l in git("status", "--porcelain").stdout.splitlines()]
    if not changed:
        return 0
    git("add", "-A")
    r = git("commit", "-q", "-m", msg or f"notes: sync ({len(changed)} files)\n\n" + "\n".join(changed[:40]))
    return len(changed) if r.returncode == 0 else 0


def agent_source():
    """The orchestrator layer to copy into system/: the image's, else this checkout's."""
    if IMAGE_AGENT.is_dir():
        return IMAGE_AGENT
    here = HERE.parent
    return here if (here / "bin/orch").exists() else None


def image_version():
    for f in (pathlib.Path("/usr/share/magi/IMAGE_VERSION"),):
        try:
            return f.read_text().strip()
        except OSError:
            pass
    src = agent_source()
    if src:  # a checkout: hash of the tree, so changes there count as a new version
        h = hashlib.sha1()
        for f in sorted(src.rglob("*")):
            if f.is_file() and "__pycache__" not in f.parts:
                h.update(str(f.relative_to(src)).encode()); h.update(f.read_bytes())
        return "tree-" + h.hexdigest()[:12]
    return "unknown"


def system_update(args=None, quiet=False):
    src = agent_source()
    if not src:
        print("system: no mAGI agent tree found (/usr/share/magi/agent)")
        return 1
    dst = SYSDIR / "agent"
    if src.resolve() == dst.resolve():
        return 0
    tmp = SYSDIR / "agent.new"
    shutil.rmtree(tmp, ignore_errors=True)
    shutil.copytree(src, tmp, symlinks=True, ignore=shutil.ignore_patterns("__pycache__", "voice", "*.pyc"))
    shutil.rmtree(dst, ignore_errors=True)
    tmp.rename(dst)
    (SYSDIR / "units.json").write_text(json.dumps(UNIT_STATES, indent=2) + "\n")
    inst = SYSDIR / "install.sh"
    inst.write_text(SYS_INSTALL)
    inst.chmod(0o755)
    (SYSDIR / "VERSION").write_text(image_version() + "\n")
    r = subprocess.run(["bash", str(inst)], capture_output=True, text=True, timeout=120)
    n = commit_notes(f"system: orchestrator layer from {src} ({image_version()})")
    if not quiet:
        print(r.stdout.strip() or r.stderr.strip())
        print(f"system: {dst} ({'committed' if n else 'no change'})")
    return r.returncode


def link_problems(fix=True):
    """Every script and unit in system/ should be linked into place; relink what is not."""
    bad = []
    for d, live in (("bin", HOME / ".local/bin"), ("systemd", HOME / ".config/systemd/user")):
        for f in sorted((SYSDIR / "agent" / d).glob("*")):
            target = live / f.name
            if not (target.is_symlink() and target.resolve() == f.resolve()):
                bad.append(str(target))
    if bad and fix:
        subprocess.run(["bash", str(SYSDIR / "install.sh")], capture_output=True, timeout=120)
        bad = link_problems(fix=False)
    return bad


def init(args):
    quiet = "--quiet" in args
    new = not (NOTES / ".git").exists()
    for d in ("templates", "Journal", "orchestrator/briefs", "orchestrator/system"):
        (NOTES / d).mkdir(parents=True, exist_ok=True)
    if not TEMPLATE.exists():
        TEMPLATE.write_text(DEFAULT_TEMPLATE)
    readme = NOTES / "README.md"
    if not readme.exists():
        readme.write_text("# Notes\n\nDaily notes in `Journal/YYYY/MM/YYYY-MM-DD.md` (template: `templates/daily.md`). "
                          "The mAGI orchestrator writes open threads, voice action items and a log into them; `orchestrator/` "
                          "holds its ledger, briefs and system files. A local git repository: `orch doctor` commits changes, "
                          "nothing is pushed.\n")
    gi = NOTES / ".gitignore"
    rules = ["orchestrator/orch.db-*", "orchestrator/backups/", "**/__pycache__/", "orchestrator/system/agent.new/"]
    have = gi.read_text().splitlines() if gi.exists() else []
    with gi.open("a") as f:
        for r in rules:
            if r not in have:
                f.write(r + "\n")
    if new:
        git("init", "-q")
        if not git("config", "user.name").stdout.strip():
            user = os.environ.get("USER") or "magi"
            git("config", "user.name", user)
            git("config", "user.email", f"{user}@localhost")
    db().commit()
    note_lines()
    # 0.2.0 kept open threads in ~/.local/share/magi/threads.md: carry the unticked ones over
    if OLD_THREADS.exists():
        for ln in OLD_THREADS.read_text().splitlines():
            m = re.match(r"- \[ \] (?:\d{4}-\d\d-\d\d \d\d:\d\d · )?(.*)", ln)
            if m:
                note_insert([f"- [ ] {m.group(1).strip()}"], top="# Tasks", sub=HEAD)
        OLD_THREADS.rename(OLD_THREADS.with_suffix(".md.moved-to-notes"))
    sync()
    commit_notes("notes: set up" if new else None)
    if not (SYSDIR / "agent").exists() or not (SYSDIR / "VERSION").exists():
        system_update(quiet=True)
    else:
        link_problems()
    if not quiet:
        print(f"notes: {NOTES} (git) · ledger {DB} · today {note_path()}")


def system_cmd(args):
    if args and args[0] == "update":
        return system_update()
    print(f"{SYSDIR} · version {(SYSDIR / 'VERSION').read_text().strip() if (SYSDIR / 'VERSION').exists() else 'none'} · "
          f"image {image_version()} · unlinked: {', '.join(link_problems(fix=False)) or 'none'}")


# ---------------------------------------------------------------- voice digest
DIGEST_PROMPT = ("Below is what a voice listener heard on this computer between {a} and {b}: the user talking to "
                 "their orchestrator agent, plus room noise and transcription errors. List only clear action items or "
                 "requests the user made, one per line, each starting with '- [ ] ' and a short plain sentence. Ignore "
                 "noise, chatter and anything already done. If there are none, answer exactly NONE.\n\n{text}")


def voice_digest(args):
    """Every 3 h (voice-digest.timer): what the listener heard since the last digest -> action items under
    "## From voice (HH:MM–HH:MM)" in today's note (via the configured agent, `magi_agents.py oneshot`). Without
    a working agent the raw lines go under "## Heard (...)" in # Notes. Silent when nothing was heard."""
    last_f = VOICE / "last-digest"
    since = dt.datetime.fromisoformat(last_f.read_text().strip()) if last_f.exists() else dt.datetime.now().astimezone() - dt.timedelta(hours=3)
    until = dt.datetime.now().astimezone()
    heard = []
    for f in sorted((VOICE / "transcripts").glob("*.jsonl")):
        for ln in f.read_text(errors="replace").splitlines():
            try:
                e = json.loads(ln)
                t = dt.datetime.fromisoformat(e["at"])
            except (ValueError, KeyError):
                continue
            if since < t <= until:
                heard.append((t, e["text"]))
    VOICE.mkdir(parents=True, exist_ok=True)
    last_f.write_text(until.isoformat(timespec="seconds"))
    if not heard:
        return 0
    span = f"{since:%H:%M}–{until:%H:%M}"
    text = "\n".join(f"{t:%H:%M} {x}" for t, x in heard)
    lib = HERE.parent / "lib/magi_agents.py"
    try:
        r = subprocess.run([sys.executable, str(lib), "oneshot", DIGEST_PROMPT.format(a=since.strftime("%H:%M"), b=until.strftime("%H:%M"), text=text)],
                           capture_output=True, text=True, timeout=400)
        out = r.stdout.strip() if r.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        out = ""
    items = [l.strip() for l in out.splitlines() if l.strip().startswith("- [ ]")]
    if items:
        p = note_insert(items, top="# Tasks", sub=f"## From voice ({span})")
        msg = f"{len(items)} action item(s) from voice ({span}) added to {p}"
    elif out.strip() == "NONE":
        msg = f"voice {span}: {len(heard)} lines heard, no action items"
    else:
        p = note_insert([f"- {t:%H:%M} {x}" for t, x in heard], top="# Notes", sub=f"## Heard ({span})")
        msg = f"voice {span}: {len(heard)} lines heard; no agent available to summarise, raw lines in {p}"
    bus("voice-digest", msg)
    commit_notes()
    print(msg)
    return 0


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd, rest = a[0], a[1:]
    if cmd == "agent":
        return agent_set(rest)
    fn = {"init": init, "spawn": spawn, "agents": agents_list, "thread": thread_cmd, "watch": watch_cmd,
          "watches": watches, "decide": decide, "deliver": deliver, "sync": sync, "status": status,
          "doctor": doctor, "up": up, "nudge-threads": nudge_threads, "voice-digest": voice_digest,
          "system": system_cmd, "note": note_cmd}.get(cmd)
    if not fn:
        sys.exit(__doc__)
    r = fn(rest)
    if isinstance(r, int):
        sys.exit(r)


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""TEST ONLY: a stand-in for the `claude` command, so the MAGI agent layer can be tested in a
VM without a Claude account. Never part of the image.

  claude auth status --json   {"loggedIn": true} once ~/.claude/stub-signed-in exists
  claude auth login           "signs in" after 3 s (creates that file)
  claude [flags...]           an idle prompt that logs every line it receives to
                              ~/.claude/stub-received.log, answers, and writes the session
                              status file Claude Code writes (~/.claude/sessions/<pid>.json)
"""
import json, os, sys, time, uuid, subprocess
HOME = os.path.expanduser("~")
CL = os.path.join(HOME, ".claude")
os.makedirs(os.path.join(CL, "sessions"), exist_ok=True)
LOG = os.path.join(CL, "stub-received.log")
SIGNED = os.path.join(CL, "stub-signed-in")
a = sys.argv[1:]


def log(msg):
    with open(LOG, "a") as f:
        f.write(f"{time.strftime('%H:%M:%S')} {msg}\n")


if a[:1] == ["--version"]:
    print("0.0.0 (claude-stub, test only)"); sys.exit(0)
if a[:2] == ["auth", "status"]:
    print(json.dumps({"loggedIn": os.path.exists(SIGNED), "authMethod": "stub"})); sys.exit(0)
if a[:2] == ["auth", "login"]:
    print("claude-stub: pretend browser sign-in... (3 s)", flush=True)
    time.sleep(3); open(SIGNED, "w").close(); print("Signed in (stub)."); log("auth login"); sys.exit(0)

sid = a[a.index("--resume") + 1] if "--resume" in a else str(uuid.uuid4())
log(f"start argv={a!r}")
pane = os.environ.get("TMUX_PANE", "")
tm = ""
if pane:
    out = subprocess.run(["tmux", "display-message", "-p", "-t", pane, "#S:#{window_id}"], capture_output=True, text=True).stdout.strip()
    tm = f"{out}.{pane}"
SF = os.path.join(CL, "sessions", f"{os.getpid()}.json")


def status(st):
    now = int(time.time() * 1000)
    json.dump({"pid": os.getpid(), "sessionId": sid, "cwd": os.getcwd(), "startedAt": now, "kind": "interactive",
               "tmux": tm, "status": st, "updatedAt": now, "statusUpdatedAt": now}, open(SF, "w"))


# the real binary's process name is "claude"; tmux-reap-stale / tmux-snapshot check /proc/<pid>/comm
try:
    import ctypes
    ctypes.CDLL(None).prctl(15, b"claude", 0, 0, 0)
except Exception:
    pass
status("idle")
print("\x1b[1m Claude Code (stub)\x1b[0m  session %s%s" % (sid, "  [resumed]" if "--resume" in a else ""))
print(" system prompt file: %s" % (a[a.index("--append-system-prompt-file") + 1] if "--append-system-prompt-file" in a else "none"))
try:
    while True:
        print("\n❯ ", end="", flush=True)
        line = sys.stdin.readline()
        if not line:
            break
        line = line.strip()
        if not line:
            continue
        log(f"received: {line}")
        status("busy")
        time.sleep(2)
        print(f"● (stub) received: {line}")
        if line.startswith("[voice]"):
            subprocess.Popen(["hud-say", "Heard you."], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        status("idle")
finally:
    try: os.unlink(SF)
    except OSError: pass

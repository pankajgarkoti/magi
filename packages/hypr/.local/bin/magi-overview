#!/usr/bin/env python3
"""magi-overview: MAGI workspace overview and window switcher (GTK 4 + hyprctl + grim).

Every open window, grouped by workspace, with live thumbnails (grim -T captures windows
on hidden workspaces too). Thumbnails are cached in ~/.cache/magi/overview and refreshed
in the background each time it opens, so it shows instantly and sharpens a moment later.

Keys
  arrows, or h j k l while the filter is empty     move
  type any other letter (or / first)               filter by app, title or workspace
  Enter                                            go to that window (switches workspace)
  Shift+Enter                                      bring that window to the current workspace
  Backspace / Ctrl+U                               edit / clear the filter
  Esc                                              clear the filter, then close

Stays resident after the first open (or `magi-overview --daemon`); `magi-overview` again hides it.
`magi-overview --quit` stops the resident process. Colours only from themes/current/colors.css.
"""
import os
import socket
import sys
import time

T0 = time.monotonic()
SOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "magi-overview.sock")


def _ask_resident():
    if __name__ != "__main__" or "--daemon" in sys.argv or "--help" in sys.argv:
        return
    try:
        c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        c.settimeout(0.5)
        c.connect(SOCK)
        c.sendall(("quit" if "--quit" in sys.argv else "toggle").encode())
        c.close()
        sys.exit(0)
    except OSError:
        pass


_ask_resident()

import json  # noqa: E402
import signal  # noqa: E402
import warnings  # noqa: E402

# layer-shell overlay when gtk4-layer-shell is installed (must load before GTK/libwayland)
sys.dont_write_bytecode = True
try:
    import eva_layer  # noqa: E402
    eva_layer.preload()
except ImportError:
    eva_layer = None

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

APP_ID = "magi-overview"
TIMING = os.environ.get("MAGI_TIMING") == "1"
STICKY = os.environ.get("MAGI_STICKY") == "1"  # testing: don't hide on focus loss
HOME = os.path.expanduser("~")
COLORS = HOME + "/.config/hypr/themes/current/colors.css"
CACHE = HOME + "/.cache/magi/overview"
THUMB_W, THUMB_H = 300, 168
CAPTURE_SCALE = "0.3"
PARALLEL = 4

CSS = """

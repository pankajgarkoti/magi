    "audio-headset": ("headset", "HEADSET"),
    "audio-headphones": ("headphones", "HEADPHONES"),
    "audio-card": ("speaker", "AUDIO"),
    "audio-speakers": ("speaker", "SPEAKER"),
    "input-mouse": ("mouse", "MOUSE"),
    "input-keyboard": ("keyboard", "KEYBOARD"),
    "input-gaming": ("gamepad", "GAMEPAD"),
    "input-tablet": ("tablet", "TABLET"),
    "phone": ("phone", "PHONE"),
    "computer": ("computer", "COMPUTER"),
    "multimedia-player": ("speaker", "PLAYER"),
    "video-display": ("computer", "DISPLAY"),
}
SCAN_SECONDS = 30

CSS = """

#!/usr/bin/env python3
"""eva-bluetooth: MAGI Bluetooth link picker for Hyprland.

GTK 4 + BlueZ over D-Bus (all calls async, never blocks the UI).
Colours come from ~/.config/hypr/themes/current/colors.css (eva-theme).

Keys: Up/Down or j/k move, Enter acts, typing (or /) filters, Backspace edits
the filter, Esc clears the filter then closes. Ctrl+S scan, Ctrl+P power.
Running it again while open closes it (toggle). EVA_BT_DRY=1 = dry run:
actions are logged and simulated, nothing is sent to BlueZ.
"""
import os
import signal
import time

T0 = time.time()
import sys

APP_ID = "eva-bluetooth"
DRY = os.environ.get("EVA_BT_DRY") == "1"
COLORS = os.environ.get("EVA_BT_COLORS") or os.path.expanduser("~/.config/hypr/themes/current/colors.css")


def single_instance():
    """Second launch closes the open picker instead of stacking another one."""
    pidf = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), APP_ID + ".pid")
    try:
        with open(pidf) as f:
            pid = int(f.read().strip())
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            if APP_ID.encode() in f.read() and pid != os.getpid():
                os.kill(pid, signal.SIGTERM)
                sys.exit(0)
    except (OSError, ValueError):
        pass
    with open(pidf, "w") as f:
        f.write(str(os.getpid()))
    return pidf


PIDFILE = single_instance()

# layer-shell overlay when gtk4-layer-shell is installed (must load before GTK/libwayland)
sys.dont_write_bytecode = True
try:
    import eva_layer  # noqa: E402
    eva_layer.preload()
except ImportError:
    eva_layer = None

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, Gio, GLib, GLibUnix, Gtk, Pango  # noqa: E402

BLUEZ = "org.bluez"
DEV = "org.bluez.Device1"
ADP = "org.bluez.Adapter1"
BAT = "org.bluez.Battery1"
PROPS = "org.freedesktop.DBus.Properties"

# Nerd Font Material Design glyphs
G = {
    "bt": "\U000f00af", "bt_off": "\U000f00b2", "bt_on": "\U000f00b1", "bt_scan": "\U000f00b0",
    "headset": "\U000f02ce", "headphones": "\U000f02cb", "speaker": "\U000f04c3",
    "mouse": "\U000f037d", "keyboard": "\U000f030c", "phone": "\U000f03f2",
    "computer": "\U000f0322", "gamepad": "\U000f0eb5", "tablet": "\U000f04f7",
    "watch": "\U000f0897", "unknown": "\U000f00af",
}

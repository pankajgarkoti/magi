#!/usr/bin/env bash
# MAGI terminal banner: orchestrator state, then quick local checks (memory, network, power).
# MAGI_NO_BANNER=1 turns it off.
c() { printf '\033[38;2;%sm' "$1"; }; R=$'\033[0m'; B=$'\033[1m'
pal=~/.config/hypr/themes/current/palette; acc="229;50;45"; acc2="255;140;26"
if [ -r "$pal" ]; then
  hex() { local h=${1#\#}; printf '%d;%d;%d' 0x${h:0:2} 0x${h:2:2} 0x${h:4:2}; }
  acc=$(hex "$(grep ^accent= $pal | cut -d= -f2)"); acc2=$(hex "$(grep ^accent2= $pal | cut -d= -f2)")
fi
green="155;229;100"; red="229;50;45"; dim="138;138;153"
verdict() { case "$1" in ok) printf "%s%sOK%s" "$(c $green)" "$B" "$R" ;; no) printf "%s%sCHECK%s" "$(c $red)" "$B" "$R" ;; *) printf "%s%s%s%s" "$(c $dim)" "$B" "$1" "$R" ;; esac; }
mem=$(awk '/MemAvailable/{printf "%d",$2/1024}' /proc/meminfo); load=$(cut -d' ' -f1 /proc/loadavg)
m=ok; [ "$mem" -lt 2000 ] && m=no
net=no; nmcli -t -f STATE general 2>/dev/null | grep -q '^connected' && net=ok
bat=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -1); st=$(cat /sys/class/power_supply/BAT*/status 2>/dev/null | head -1)
b=ok; [ -n "$bat" ] && [ "$bat" -lt 20 ] && [ "$st" != Charging ] && b=no
w=$(( $(tput cols 2>/dev/null || echo 80) < 72 ? $(tput cols 2>/dev/null || echo 80) : 72 ))
line=$(printf '━%.0s' $(seq 1 $w))
echo
printf "%s%s%s\n" "$(c $acc)" "$line" "$R"
printf "  %s%sMAGI%s  %s%s%s\n" "$(c $acc)" "$B" "$R" "$(c $dim)" "$(date '+%a %d %b · %H:%M')  ·  $(hostname -s)" "$R"
printf "%s%s%s\n" "$(c $acc)" "$line" "$R"
row() { printf "  %s%-13s%s %s%-34s%s %s\n" "$(c $acc2)" "$1" "$R" "$(c $dim)" "$2" "$R" "$(verdict "$3")"; }
if command -v magi-agent >/dev/null; then
  o=$(magi-agent status --json 2>/dev/null | python3 -c 'import json,sys
d=json.load(sys.stdin); print(d["orchestrator"], d["agents"], d["listener"])' 2>/dev/null)
  read -r ost oag olis <<< "${o:-? 0 ?}"
  case "$ost" in IDLE|WORKING) ov=ok ;; ASKING|OFFLINE|DOWN) ov=no ;; *) ov=$ost ;; esac
  row ORCHESTRATOR "$ost · $oag agents · listener ${olis,,} · SUPER+\`" "$ov"
fi
p="on AC power"; [ -n "$bat" ] && p="battery ${bat}% ${st,,}"
row SYSTEM "mem ${mem}M free · load ${load} · $p" "$( [ $m = ok ] && [ $b = ok ] && echo ok || echo no )"
row NETWORK "$( [ $net = ok ] && echo online || echo offline )" $net
printf "%s%s%s\n\n" "$(c $acc)" "$line" "$R"

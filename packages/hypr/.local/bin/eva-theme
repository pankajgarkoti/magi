#!/usr/bin/env bash
# Switch the desktop theme: eva-theme nerv | unit01 | blue | toggle (cycles nerv -> unit01 -> blue)
set -e
T=~/.config/hypr/themes
cur=$(basename "$(readlink -f $T/current)")
case "${1:-toggle}" in
  toggle) case "$cur" in nerv) new=unit01 ;; unit01) new=blue ;; *) new=nerv ;; esac ;;
  nerv|unit01|blue) new=$1 ;;
  *) echo "usage: eva-theme nerv|unit01|blue|toggle"; exit 2 ;;
esac
ln -sfn "$new" $T/current
. $T/current/palette
W=~/Pictures/wallpapers/eva
wall=$(grep -o '"[^"]*\.\(png\|jpg\)"' $T/current/theme.lua | tr -d '"')
# the EVA wallpapers are downloaded at install time and may be missing (offline install):
# fall back to the generated blue one, then to anything in the folder
[ -f "$W/$wall" ] || wall=catppuccin-blue.png
[ -f "$W/$wall" ] || wall=$(cd "$W" 2>/dev/null && ls | grep -iE '\.(png|jpg)$' | head -1)
# live = running inside a Hyprland session (not the installer, a tty or ssh)
live=; [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && live=1
mkdir -p ~/.config/mako ~/.config/wofi ~/.config/hypr ~/.cache

# notifications (mako has no include, so it is generated)
cat > ~/.config/mako/config <<CONF
font=IosevkaTerm Nerd Font Mono 11
background-color=${base}dd
text-color=$text
border-color=$accent
progress-color=over $surface
border-size=2
border-radius=0
padding=10
default-timeout=6000
anchor=top-right
[urgency=high]
background-color=#1a0f00ee
text-color=#ffb347
border-color=#ff8c1a
border-size=4
format=<b>⚠ 警告 · %s</b>\n%b
default-timeout=0
CONF

# launcher
cat > ~/.config/wofi/style.css <<CSS
* { font-family: "IosevkaTerm Nerd Font Mono"; font-size: 14px; border-radius: 0; }
window { background-color: alpha($base, 0.92); border: 2px solid $accent; }
#input { margin: 8px; padding: 6px 10px; color: $text; background-color: $surface; border: 1px solid $surface; }
#entry { padding: 6px 10px; color: $text; }
#entry:selected { background-color: $accent; }
#entry:selected #text { color: $base; font-weight: bold; }
CSS

# lock screen: hex lattice over the theme wallpaper
eva-lock-image >/dev/null || echo "eva-theme: lock image not generated" >&2
case "$new" in nerv) label="NERV · AUTHORISATION REQUIRED" ;; unit01) label="EVA UNIT-01 · PILOT AUTHORISATION" ;; *) label="MAGI · AUTHORISATION REQUIRED" ;; esac
cat > ~/.config/hypr/hyprlock.conf <<CONF
general {
    hide_cursor = true
}
background {
    path = ~/.cache/eva-lock.png
}
label {
    text = \$TIME
    font_family = IosevkaTerm Nerd Font Mono
    font_size = 84
    color = rgb(${accent2#\#})
    position = 0, 140
    halign = center
    valign = center
}
label {
    text = $label
    font_family = IosevkaTerm Nerd Font Mono
    font_size = 13
    color = rgb(${accent#\#})
    position = 0, 50
    halign = center
    valign = center
}
input-field {
    size = 340, 46
    rounding = 0
    outline_thickness = 2
    outer_color = rgb(${accent#\#})
    inner_color = rgba(0,0,0,0.75)
    font_color = rgb(${text#\#})
    check_color = rgb(9be564)
    fail_color = rgb(ff8c1a)
    placeholder_text = password
    position = 0, -30
    halign = center
    valign = center
}
CONF

# every colour in colors.css as $C_<name> (C_base, C_surface1, C_dim, C_bad...)
eval "$(sed -n 's/^@define-color \([a-z0-9_]*\) \(#[0-9a-fA-F]*\);.*/C_\1=\2/p' $T/current/colors.css)"

# polkit password prompt (hyprpolkitagent draws with hyprtoolkit)
cat > ~/.config/hypr/hyprtoolkit.conf <<CONF
# generated by eva-theme ($new)
background = rgba(${C_base#\#}f2)
base = rgb(${C_surface0#\#})
alternate_base = rgb(${C_surface1#\#})
text = rgb(${C_text#\#})
bright_text = rgb(ffffff)
accent = rgb(${C_accent#\#})
accent_secondary = rgb(${C_accent2#\#})
font_family = IosevkaTerm Nerd Font Mono
font_family_monospace = IosevkaTerm Nerd Font Mono
rounding_large = 0
rounding_small = 0
CONF

# GNOME Text Editor / any GtkSourceView 5 app
mkdir -p ~/.local/share/gtksourceview-5/styles
cat > ~/.local/share/gtksourceview-5/styles/eva.xml <<XML
<?xml version="1.0" encoding="UTF-8"?>
<!-- generated by eva-theme ($new) -->
<style-scheme id="eva" name="EVA" version="1.0">
  <author>eva-theme</author>
  <description>Evangelion desktop theme, follows eva-theme</description>
  <metadata><property name="variant">dark</property></metadata>
  <color name="base" value="$C_base"/>
  <color name="surface0" value="$C_surface0"/>
  <color name="surface1" value="$C_surface1"/>
  <color name="text" value="$C_text"/>
  <color name="dim" value="$C_dim"/>
  <color name="accent" value="$C_accent"/>
  <color name="accent2" value="$C_accent2"/>
  <color name="c1" value="$C_c1"/>
  <color name="c2" value="$C_c2"/>
  <color name="good" value="$C_good"/>
  <color name="warn" value="$C_warn"/>
  <color name="bad" value="$C_bad"/>
  <style name="text" foreground="text" background="base"/>
  <style name="selection" foreground="base" background="accent"/>
  <style name="selection-unfocused" foreground="text" background="surface1"/>
  <style name="cursor" foreground="accent2"/>
  <style name="current-line" background="surface0"/>
  <style name="line-numbers" foreground="dim" background="base"/>
  <style name="current-line-number" foreground="accent" background="surface0" bold="true"/>
  <style name="right-margin" foreground="surface1" background="surface0"/>
  <style name="background-pattern" background="surface0"/>
  <style name="bracket-match" foreground="base" background="accent2" bold="true"/>
  <style name="bracket-mismatch" foreground="base" background="bad"/>
  <style name="search-match" foreground="base" background="warn"/>
  <style name="draw-spaces" foreground="surface1"/>
  <style name="def:comment" foreground="dim" italic="true"/>
  <style name="def:shebang" foreground="dim" bold="true"/>
  <style name="def:doc-comment-element" foreground="dim" bold="true"/>
  <style name="def:constant" foreground="c1"/>
  <style name="def:string" foreground="good"/>
  <style name="def:special-char" foreground="warn"/>
  <style name="def:number" foreground="warn"/>
  <style name="def:boolean" foreground="warn" bold="true"/>
  <style name="def:keyword" foreground="accent" bold="true"/>
  <style name="def:statement" foreground="accent" bold="true"/>
  <style name="def:type" foreground="accent2"/>
  <style name="def:function" foreground="c1"/>
  <style name="def:identifier" foreground="text"/>
  <style name="def:preprocessor" foreground="c2"/>
  <style name="def:builtin" foreground="accent2"/>
  <style name="def:operator" foreground="dim"/>
  <style name="def:error" foreground="bad" underline="error"/>
  <style name="def:warning" foreground="warn" underline="error"/>
  <style name="def:note" foreground="base" background="warn" bold="true"/>
  <style name="def:heading" foreground="accent" bold="true"/>
  <style name="def:emphasis" italic="true"/>
  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:link-text" foreground="c1" underline="single"/>
  <style name="def:inline-code" foreground="accent2" background="surface0"/>
  <style name="diff:added-line" foreground="good"/>
  <style name="diff:removed-line" foreground="bad"/>
  <style name="diff:location" foreground="c1"/>
</style-scheme>
XML

# GTK: EVA theme (Adwaita dark + colors.css), EVA icons, Adwaita cursor
eva-gtk-theme -q 2>/dev/null || true
eva-icons -q 2>/dev/null || true
gs() { gsettings set org.gnome.desktop.interface "$@" 2>/dev/null || true; }
gs color-scheme prefer-dark
gs accent-color "$(case "$new" in nerv) echo red ;; unit01) echo purple ;; *) echo blue ;; esac)"
gs icon-theme EVA
gs cursor-theme Adwaita
gs cursor-size 24
gsettings set org.gnome.TextEditor style-scheme eva 2>/dev/null || true
# X11/XWayland GTK apps get the same settings from xsettingsd (started at login by
# hyprland.lua); this regenerates its config and SIGHUPs it to reload
xs=~/.config/xsettingsd/xsettingsd.conf
xsettings() {
  mkdir -p "${xs%/*}"
  cat > "$xs" <<CONF
# generated by eva-theme ($new): GTK settings for X11/XWayland apps
Net/ThemeName "$1"
Net/IconThemeName "EVA"
Gtk/CursorThemeName "Adwaita"
Gtk/CursorThemeSize 24
Gtk/FontName "IosevkaTerm Nerd Font Mono 10"
Gtk/MonospaceFontName "IosevkaTerm Nerd Font Mono 11"
Gtk/ApplicationPreferDarkTheme 1
Xft/Antialias 1
Xft/Hinting 1
Xft/HintStyle "hintslight"
Xft/RGBA "none"
Xft/DPI 98304
CONF
  pkill -HUP -x xsettingsd 2>/dev/null || true
}
# flip the GTK theme so running GTK 3 apps reload their CSS with the new colours
gs gtk-theme Adwaita; xsettings Adwaita; sleep 0.2; gs gtk-theme EVA; xsettings EVA
[ -n "$live" ] && { systemctl --user try-restart hyprpolkitagent.service 2>/dev/null || true; }
# libadwaita apps read their colours once at start. Nautilus stays resident
# after its last window closes, so quit it (only if no window is open) to
# have the next SUPER+E come up in the new colours.
[ -n "$live" ] && { hyprctl clients -j 2>/dev/null | grep -q '"org.gnome.Nautilus"' || nautilus -q 2>/dev/null || true; }

# terminals: alacritty imports themes/current/alacritty.toml; touching the
# config makes it reload and re-follow the symlink. tmux re-reads its colours.
touch ~/.config/alacritty.toml 2>/dev/null || true
tmux source-file ~/.tmux.conf 2>/dev/null || true

# wallpaper (wall-next only restarts hyprpaper inside a session)
[ -n "$wall" ] && wall-next "$W/$wall"
# apply live
if [ -n "$live" ]; then
  hyprctl reload >/dev/null 2>&1 || true
  pkill -SIGUSR2 waybar || true
  makoctl reload 2>/dev/null || true
  notify-send "MAGI" "Theme: $new" 2>/dev/null || true
fi
echo "theme: $new"

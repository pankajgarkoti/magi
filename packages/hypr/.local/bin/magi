#!/usr/bin/env python3
"""magi: the MAGI control centre. One keyboard-first panel for the Evangelion Hyprland desktop.

Sections: AGENTS (orchestrator, listener, agent windows; magi-agent), NETWORK (eva-wifi), BLUETOOTH (eva-bluetooth), SOUND, DISPLAY, POWER, THEME,
TOOLS (overview, files, clipboard, screenshots).
Colours come only from ~/.config/hypr/themes/current/colors.css (plus the theme swatches,
read from each theme's palette file), so `eva-theme` restyles it, live if it is open.

Keys
  Up/Down, j/k        move              1-8        jump to a section
  Left/Right, h/l     adjust a slider or option; Left on a plain row goes back to the sections
  Enter / Space       act (power actions ask once more: Enter again executes, Esc aborts)
  Tab                 sections <-> panel                 Esc       back / abort / close
  m                   mute output        r          refresh

`magi sound` opens on a section. Running `magi` while it is open hides it (toggle).
It stays resident after the first open (or `magi --daemon` at login), so later opens are instant;
`magi --quit` stops the resident process.
MAGI_DRY_RUN=1 prints the lock/suspend/log out/reboot/shutdown commands instead of running them.
"""
import os
import socket
import sys
import time

T0 = time.monotonic()
SOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "magi.sock")


def _ask_resident():
    """Fast path: if the resident panel is running, hand it our args and exit before importing GTK."""
    if __name__ != "__main__" or "--daemon" in sys.argv or "--help" in sys.argv:
        return
    try:
        c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        c.settimeout(0.5)
        c.connect(SOCK)
        c.sendall(("toggle " + " ".join(sys.argv[1:])).strip().encode())
        c.close()
        sys.exit(0)
    except OSError:
        pass


_ask_resident()


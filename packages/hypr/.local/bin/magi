    # ------------------------------------------------------------- THEME

    def build_theme(self, p):
        p.section("THEME")
        sw_css = []
        self.theme_rows = {}
        for key, name, meta in (("nerv", "NERV", "red · orange · black · command centre"),
                                ("unit01", "EVA UNIT-01", "purple · green · test type"),
                                ("blue", "BLUE", "blue · mauve · slate · the original")):
            r = p.add(Row(self, "theme:" + key, "󰏘", name, meta, activate=lambda k=key: self.set_theme(k)))
            pal = palette(key)
            for slot in ("accent", "accent2", "surface", "text"):
                if slot in pal:
                    cls = "sw-%s-%s" % (key, slot)
                    sw_css.append(".%s { background: %s; }" % (cls, pal[slot]))
                    s = Gtk.Box(valign=Gtk.Align.CENTER)
                    s.add_css_class("sw")
                    s.add_css_class(cls)
                    r.tail.append(s)
            r.tail.append(lbl("", "chip"))
            self.theme_rows[key] = r
        # swatches show the *other* theme too, so they come from each theme's palette file
        sw = Gtk.CssProvider()
        sw.load_from_string("\n".join(sw_css))
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), sw, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
        self.wall_cnt = p.section("WALLPAPER")
        self.next_row = p.add(Row(self, "wall-next", "󰸉", "NEXT WALLPAPER", "SUPER+W", activate=self.next_wall,
                                  glyph_class="ctl"))
        self.walls = sorted(os.path.join(WALL_DIR, f) for f in (os.listdir(WALL_DIR) if os.path.isdir(WALL_DIR) else [])
                            if f.lower().endswith((".png", ".jpg", ".jpeg", ".webp")))
        self.wall_cnt.set_label("%02d" % len(self.walls))
        grid = Gtk.Grid(column_spacing=8, row_spacing=8)
        grid.add_css_class("grid")
        p.add(grid)
        cols = 4
        self.thumb_rows = {}
        for i, path in enumerate(self.walls):
            r = Row(self, "wall:" + path, None, "", activate=lambda path=path: self.set_wall(path))
            r.add_css_class("thumb")
            r.remove(r.body)
            r.remove(r.tail)
            ov = Gtk.Overlay()
            pic = Gtk.Picture(content_fit=Gtk.ContentFit.COVER, can_shrink=True)
            pic.set_size_request(146, 82)
            ov.set_child(pic)
            tag = lbl("LIVE", "thumbtag", xalign=0.5)
            tag.set_halign(Gtk.Align.START)
            tag.set_valign(Gtk.Align.START)
            tag.set_visible(False)
            ov.add_overlay(tag)
            r.append(ov)
            r.pic, r.tag = pic, tag
            r.set_tooltip_text(os.path.basename(path))
            r.grid = (cols, i, len(self.walls))
            grid.attach(r, i % cols, i // cols, 1, 1)
            self.thumb_rows[path] = r
        self.mark_theme()

    def mark_theme(self):
        cur = current_theme()
        for key, r in self.theme_rows.items():
            on = key == cur
            (r.add_css_class if on else r.remove_css_class)("cur")
            c = r.tail.get_last_child()
            c.set_label("LIVE" if on else "")
            c.set_visible(on)
            for k in ("acc",):
                (c.add_css_class if on else c.remove_css_class)(k)
        self.tab_tags["theme"].set_label({"nerv": "NERV", "unit01": "UNIT-01"}.get(cur, "BLUE"))
        wall = read(WALL_STATE)
        for path, r in self.thumb_rows.items():
            on = path == wall
            (r.add_css_class if on else r.remove_css_class)("cur")
            r.tag.set_visible(on)
        self.next_row.set_meta("SUPER+W · now " + (os.path.basename(wall) if wall else "--"))

    def set_theme(self, key):
        if key == current_theme():
            self.status("ALREADY ON %s" % key.upper(), "info")
            return
        self.status("SWITCHING TO %s…" % key.upper(), "warn", sticky=True)

        def done(ok, _o, err):
            self.css.load_from_string(CSS)  # @import re-reads themes/current
            GLib.timeout_add(600, lambda: self.mark_theme() or False)
            self.status("THEME · %s" % key.upper() if ok else "THEME FAILED · " + err.strip()[:50], "ok" if ok else "err")
        run_async(["eva-theme", key], done)

    def next_wall(self):
        run_async(["wall-next"], lambda *_: GLib.timeout_add(150, lambda: self.mark_theme() or False))

    def set_wall(self, path):
        self.status("WALLPAPER · " + os.path.basename(path), "ok")
        run_async(["wall-next", path], lambda *_: GLib.timeout_add(150, lambda: self.mark_theme() or False))

    def load_thumbs(self):
        """Scale wallpapers to small cached PNGs in a thread; set them as they arrive."""
        self.thumbs_started = True
        jobs = list(self.thumb_rows.items())

        def work():
            from gi.repository import GdkPixbuf
            os.makedirs(THUMB_DIR, exist_ok=True)
            for path, row in jobs:
                try:
                    st = os.stat(path)
                    h = hashlib.sha1(("%s:%d:%d" % (path, st.st_mtime_ns, st.st_size)).encode()).hexdigest()
                    out = os.path.join(THUMB_DIR, h + ".png")
                    if not os.path.exists(out):
                        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 320, 180, True)
                        pb.savev(out + ".tmp", "png", [], [])
                        os.replace(out + ".tmp", out)
                    GLib.idle_add(self._set_thumb, row, out)
                except (GLib.Error, OSError):
                    pass
        threading.Thread(target=work, daemon=True).start()

    def _set_thumb(self, row, out):
        try:
            row.pic.set_paintable(Gdk.Texture.new_from_filename(out))
        except GLib.Error:
            pass
        return False


# ----------------------------------------------------------------- main

def main():
    args = [a.lower() for a in sys.argv[1:]]
    if "--help" in args or "-h" in args:
        print(__doc__)
        return 0
    if "--quit" in args:
        return 0  # nothing resident (the fast path above would have reached it)
    daemon = "--daemon" in args
    args = [a.lstrip("-") for a in args if a != "--daemon"]
    arg = args[0] if args else ""
    start = ALIASES.get(arg, arg) or None
    if start is not None and start not in [s[0] for s in SECTIONS]:
        print("magi: unknown section %r (network bluetooth sound display power theme)" % arg, file=sys.stderr)
        return 2
    last = read(os.path.join(STATE_DIR, "section"))
    start_sel = start or (last if last in [s[0] for s in SECTIONS] else "sound")

    # become the resident: claim the socket (a stale one from a crash is replaced)
    try:
        os.unlink(SOCK)
    except OSError:
        pass

    GLib.set_prgname(APP_ID)
    GLib.set_application_name("MAGI · CONTROL")
    app = Gtk.Application(flags=Gio.ApplicationFlags.NON_UNIQUE)
    state = {}

    def incoming(_svc, conn, _src):
        try:
            data = conn.get_input_stream().read_bytes(512, None).get_data().decode(errors="replace").split()
        except GLib.Error:
            return False
        w = state.get("win")
        if not data or w is None:
            return False
        if data[0] == "quit":
            app.quit()
        elif data[0] == "key" and len(data) > 1 and w.get_visible():
            # test hook: inject a key into this process only (never into other windows)
            mods = Gdk.ModifierType.SHIFT_MASK if data[1].startswith("S-") else 0
            w.on_key(None, Gdk.keyval_from_name(data[1][2:] if mods else data[1]), 0, mods)
        elif data[0] == "toggle":
            rest = [a.lstrip("-") for a in data[1:]]
            if "quit" in rest:
                app.quit()
                return False
            sec = ALIASES.get(rest[0], rest[0]) if rest else None
            w.toggle(sec if sec in [s[0] for s in SECTIONS] else None)
        return False

    def activate(a):
        prov = Gtk.CssProvider()
        prov.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        t1 = time.monotonic()
        w = Magi(a, prov, start_sel, pane=start is not None)
        state["win"] = w
        a.hold()
        svc = Gio.SocketService()
        svc.add_address(Gio.UnixSocketAddress.new(SOCK), Gio.SocketType.STREAM, Gio.SocketProtocol.DEFAULT, None)
        svc.connect("incoming", incoming)
        svc.start()
        state["svc"] = svc
        if TIMING:
            print("magi: imports %.0f ms, activate %.0f ms, window built %.0f ms" % (
                (T_IMPORT - T0) * 1000, (t1 - T0) * 1000, (time.monotonic() - T0) * 1000))
        if not daemon:
            w.show_panel()

    app.connect("activate", activate)
    warnings.simplefilter("ignore", DeprecationWarning)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda: app.quit() or False)
    try:
        return app.run([sys.argv[0]])
    finally:
        w = state.get("win")
        if w is not None:
            w.pa_stop()
        try:
            os.unlink(SOCK)
        except OSError:
            pass


if __name__ == "__main__":
    sys.exit(main())

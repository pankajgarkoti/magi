#!/usr/bin/env python3
"""eva-wifi: MAGI network link, a keyboard-first Wi-Fi picker (GTK 4 + nmcli).

Colours come only from ~/.config/hypr/themes/current/colors.css, so `eva-theme toggle`
restyles it on the next open. Running it again while it is open closes it (toggle).

Resident: the first run stays alive with the window hidden and listens on
$XDG_RUNTIME_DIR/eva-wifi.sock; later runs only poke that socket (no GTK import), so the
picker opens in a few tens of ms. `eva-wifi --daemon` starts it hidden (used at login).

Keys: Up/Down or j/k move, Enter acts, type to filter (Backspace edits, Ctrl+U clears),
Ctrl+R / F5 rescan, Esc clears the filter / cancels the password field / closes.

EVA_WIFI_DRY_RUN=1 prints actions instead of running them (passwords are redacted).
"""
import os
import signal
import socket
import sys
import warnings

RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
SOCK = os.path.join(RUNTIME, "eva-wifi.sock")


def poke_resident(msg=b"toggle"):
    """Send msg to a running instance (toggle | ping). True if one answered."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
            c.settimeout(0.5)
            c.connect(SOCK)
            c.sendall(msg + b"\n")
        return True
    except OSError:
        return False


if __name__ == "__main__" and "--daemon" not in sys.argv[1:] and poke_resident():
    sys.exit(0)

# The cairo renderer skips GL/Vulkan setup: ~100 ms faster to first frame for a UI this simple.
os.environ.setdefault("GSK_RENDERER", "cairo")

# layer-shell overlay when gtk4-layer-shell is installed (must load before GTK/libwayland)
sys.dont_write_bytecode = True
try:
    import eva_layer
    eva_layer.preload()
except ImportError:
    eva_layer = None

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

APP_ID = "eva-wifi"
DRY_RUN = os.environ.get("EVA_WIFI_DRY_RUN") == "1"
COLORS = os.path.expanduser("~/.config/hypr/themes/current/colors.css")

CSS = """

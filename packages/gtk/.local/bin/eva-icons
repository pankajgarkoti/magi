#!/usr/bin/env python3
"""Generate the EVA icon theme in ~/.local/share/icons/EVA.

Adwaita's rounded blue folders become hard-edged, chamfered black-glass
folders with a thin accent outline, in the colours of
~/.config/hypr/themes/current/colors.css. The emblem on each folder (music
note, download arrow...) is lifted from Adwaita's own SVG and recoloured.
Everything else inherits from Adwaita. eva-theme reruns this on every switch.
"""
import os
import re
import sys

ADW = "/usr/share/icons/Adwaita/scalable/places"
OUT = os.path.expanduser("~/.local/share/icons/EVA")
COLORS = os.path.expanduser("~/.config/hypr/themes/current/colors.css")
# Adwaita folder icons: the first three <path>s are the folder, the rest the emblem
FOLDERS = ["folder", "folder-documents", "folder-download", "folder-music",
           "folder-pictures", "folder-publicshare", "folder-templates",
           "folder-videos", "folder-drag-accept", "user-home", "user-desktop",
           "user-bookmarks"]


def palette():
    c = dict(re.findall(r"@define-color\s+(\w+)\s+(#[0-9a-fA-F]{6})", open(COLORS).read()))
    return c


def shade(hexs, k):
    r, g, b = (int(hexs[i:i + 2], 16) for i in (1, 3, 5))
    return "#%02x%02x%02x" % tuple(max(0, min(255, int(v * k))) for v in (r, g, b))


def emblem(name):
    svg = open(os.path.join(ADW, name + ".svg")).read()
    paths = re.findall(r"<path\b[^>]*/>", svg)[3:]
    # some emblems inherit their fill from a <g>: set it on every path
    return "\n".join(re.sub(r"<path\b", '<path fill="{fill}"', re.sub(r'\s*fill="[^"]*"', "", p))
                     for p in paths)


def folder(c, name):
    accent, accent2 = c["accent"], c["accent2"]
    drag = name == "folder-drag-accept"
    body = shade(c["surface1"], 1.25) if drag else c["surface1"]
    em = emblem(name).replace("{fill}", accent)
    return f'''<svg xmlns="http://www.w3.org/2000/svg" width="128" height="128" viewBox="0 0 128 128">
  <polygon points="12,14 50,14 58,26 116,26 116,112 12,112" fill="{shade(accent, 0.45)}"/>
  <polygon points="12,36 102,36 116,50 116,116 12,116" fill="{body}" stroke="{accent}" stroke-width="3" stroke-linejoin="miter"/>
  <rect x="20" y="44" width="26" height="4" fill="{accent2}"/>
  <rect x="50" y="44" width="6" height="4" fill="{accent}"/>
{em}
</svg>
'''


def main():
    c = palette()
    d = os.path.join(OUT, "scalable/places")
    os.makedirs(d, exist_ok=True)
    for name in FOLDERS:
        if os.path.exists(os.path.join(ADW, name + ".svg")):
            with open(os.path.join(d, name + ".svg"), "w") as f:
                f.write(folder(c, name))
    with open(os.path.join(OUT, "index.theme"), "w") as f:
        f.write("""[Icon Theme]
Name=EVA
Comment=Evangelion folders over Adwaita (generated by eva-icons)
Inherits=Adwaita,hicolor
Directories=scalable/places

[scalable/places]
Size=128
MinSize=16
MaxSize=512
Type=Scalable
Context=Places
""")
    # bump the theme dir mtime so running GTK apps notice the change
    os.utime(OUT)
    if "-q" not in sys.argv:
        print(f"EVA icons written to {OUT}")


if __name__ == "__main__":
    main()

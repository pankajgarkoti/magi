#!/usr/bin/env python3
"""Generate the EVA GTK theme in ~/.local/share/themes/EVA/gtk-{3,4}.0/.

Takes GTK's built-in dark stylesheets (GTK 3 Adwaita dark, GTK 4 Default
dark; libadwaita apps ignore themes and use ~/.config/gtk-4.0/gtk.css) and
swaps their literal colours
for the names defined in ~/.config/hypr/themes/current/colors.css (@base,
@surface0, @accent, @bad...), so every widget Adwaita styles follows the
active Evangelion theme, then loads eva.css (hard edges, header bars, menus)
on top. Colours are references, so switching theme needs no regeneration;
eva-theme reruns this anyway to track GTK updates.
"""
import colorsys
import os
import re
import sys

import subprocess

import gi

THEME = os.path.expanduser("~/.local/share/themes/EVA")
COLORS = "../../../../../.config/hypr/themes/current/colors.css"
VARIANTS = {  # gtk version -> (built-in dark stylesheet, generated base name)
    "3": ("/org/gtk/libgtk/theme/Adwaita/gtk-contained-dark.css", "adwaita-eva.css"),
    "4": ("/org/gtk/libgtk/theme/Default/Default-dark.css", "default-eva.css"),
}

# Adwaita dark greys by role -> theme names
GREYS = {
    "353535": "@base", "2d2d2d": "@base", "1e1e1e": "@base", "1a1a1a": "@base",
    "202020": "@surface0", "232323": "@surface0", "262626": "@surface0",
    "282828": "@surface0", "2a2a2a": "@surface0", "2b2b2b": "@surface0",
    "2e2e2e": "@surface0", "2f2f2f": "@surface0", "303030": "@surface0",
    "313131": "@surface0", "323232": "@surface0",
    "1b1b1b": "@surface1", "373737": "@surface1", "3a3a39": "@surface1",
    "404040": "@surface1", "424242": "@surface1", "444444": "@surface1",
    "5b5b5b": "mix(@surface1, @dim, 0.35)", "5a5a59": "mix(@surface1, @dim, 0.35)",
    "636362": "mix(@surface1, @dim, 0.45)",
    "737373": "@dim", "8a8a89": "@dim", "8e8e8d": "@dim", "919190": "@dim",
    "a4a4a3": "@dim",
    "c9c9c7": "@text", "d6d6d6": "@text", "eeeeec": "@text",
}
RGBA_GREYS = {  # (r,g,b) -> name, for rgba(...) literals
    (238, 238, 236): "@text",
    (38, 38, 38): "@base", (32, 32, 32): "@base", (27, 27, 27): "@base",
    (53, 53, 53): "@base", (45, 45, 45): "@base",
    (58, 58, 57): "@surface1", (68, 68, 68): "@surface1",
    (145, 145, 144): "@dim", (91, 91, 91): "@dim", (91, 91, 90): "@dim", (90, 90, 89): "@dim",
}
# chromatic families: hue range -> (name, Adwaita reference colour)
FAMILIES = [
    ((190, 250), "@accent", "15539e"),
    ((345, 360), "@bad", "cc0000"),
    ((0, 15), "@bad", "cc0000"),
    ((15, 50), "@warn", "f57900"),
    ((75, 160), "@good", "4e9a06"),
]


def hls(hexs):
    r, g, b = (int(hexs[i:i + 2], 16) / 255 for i in (0, 2, 4))
    return colorsys.rgb_to_hls(r, g, b)


def chromatic(hexs):
    h, l, s = hls(hexs)
    if s < 0.25 or l < 0.03 or l > 0.97:
        return None
    hue = h * 360
    for (lo, hi), name, ref in FAMILIES:
        if lo <= hue < hi:
            k = max(0.15, min(2.2, l / hls(ref)[1]))
            return name if abs(k - 1) < 0.06 else f"shade({name}, {k:.2f})"
    return None


def swap_hex(m):
    hexs = m.group(1).lower()
    if hexs in GREYS:
        return GREYS[hexs]
    return chromatic(hexs) or m.group(0)


def swap_rgba(m):
    r, g, b, a = int(m.group(1)), int(m.group(2)), int(m.group(3)), m.group(4)
    name = RGBA_GREYS.get((r, g, b)) or chromatic(f"{r:02x}{g:02x}{b:02x}")
    return f"alpha({name}, {a})" if name else m.group(0)


def generate(ver):
    gi.require_version("Gtk", f"{ver}.0")
    from gi.repository import Gio, Gtk  # noqa: F401  (loading Gtk registers its resources)

    src, base = VARIANTS[ver]
    css = Gio.resources_lookup_data(src, 0).get_data().decode()
    css = css.replace('url("assets/', f'url("resource://{src.rsplit("/", 1)[0]}/assets/')
    css = re.sub(r"#([0-9a-fA-F]{6})\b", swap_hex, css)
    css = re.sub(r"rgba\((\d+), ?(\d+), ?(\d+), ?([0-9.]+)\)", swap_rgba, css)
    # hard edges: the stock per-widget radii would beat a `* { border-radius: 0 }`
    css = re.sub(r"((?:-gtk-outline-)?border(?:-[a-z]+)*-radius):[^;}]*", r"\1: 0", css)
    out = os.path.join(THEME, f"gtk-{ver}.0")
    os.makedirs(out, exist_ok=True)
    with open(os.path.join(out, base), "w") as f:
        f.write(f"/* generated by eva-gtk-theme from {src}: do not edit */\n{css}")
    imports = [COLORS, base] + (["eva.css"] if ver == "3" else [])
    with open(os.path.join(out, "gtk.css"), "w") as f:
        f.write("/* generated by eva-gtk-theme: edit eva.css (in ~/dotfiles/gtk) instead */\n")
        f.writelines(f'@import url("{i}");\n' for i in imports)
    return out


def main():
    if "--gtk" in sys.argv:  # child process: one GTK major version per process
        generate(sys.argv[sys.argv.index("--gtk") + 1])
        return
    for ver in VARIANTS:
        subprocess.run([sys.executable, "-W", "ignore", __file__, "--gtk", ver], check=True)
    if "-q" not in sys.argv:
        print(f"EVA GTK 3 + 4 theme written to {THEME}")


if __name__ == "__main__":
    main()
